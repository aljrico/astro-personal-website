---
import { siteConfig } from "@/site-config";
const url = Astro.url;
---

<header
	id="main-header"
	class="relative z-50 mb-5 flex items-start sm:mb-6"
	transition:animate="none"
>
	<a
		href="/"
		class="title text-2xl hover:opacity-80"
		aria-current={url.pathname === "/" ? "page" : false}
	>
		{siteConfig.author}
	</a>
</header>
