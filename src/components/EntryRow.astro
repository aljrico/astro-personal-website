---
import SectionIcon from "@/components/SectionIcon";
import { monthYear } from "@/utils";

interface Props {
	href: string;
	title: string;
	date: Date;
}

const { href, title, date } = Astro.props;
---

<li class="iconed">
	<SectionIcon name="post" />
	<a class="what" href={href}>{title}</a>
	<time class="status" datetime={date.toISOString()}>{monthYear(date)}</time>
</li>
