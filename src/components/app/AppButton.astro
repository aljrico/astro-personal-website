---
import { Icon } from "astro-icon";
import type { ProjectLink } from "../../data/projects";

type Props = ProjectLink;

const { href, label, icon, disabled = false } = Astro.props;
const external = !href.startsWith("/") && !href.startsWith("#");
---

{
	disabled ? (
		<a
			href={href}
			class="inline-flex cursor-default items-center gap-2 rounded-md bg-accent px-4 py-2 text-bgColor opacity-60"
		>
			<Icon name={icon} class="h-5 w-5" />
			{label}
		</a>
	) : (
		<a
			href={href}
			target={external ? "_blank" : undefined}
			rel={external ? "noopener noreferrer" : undefined}
			class="inline-flex items-center gap-2 rounded-md bg-accent px-4 py-2 text-bgColor transition-all hover:opacity-80"
		>
			<Icon name={icon} class="h-5 w-5" />
			{label}
		</a>
	)
}
