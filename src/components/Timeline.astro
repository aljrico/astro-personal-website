---
import YearRange from "@/components/YearRange";
import { yearRange } from "@/utils";

type Item = {
	/** "2022-present", "2018-2019" or "2017". */
	period: string;
	title: string;
	href?: string;
	/** Company, school or venue, after the title in muted ink. */
	org?: string;
	where?: string;
	note?: string;
};

type Props = { items: Item[] };

const { items } = Astro.props;
---

<ol class="timeline">
	{
		items.map(({ period, title, href, org, where, note }) => (
			<li class:list={{ active: yearRange(period).ongoing }}>
				<p class="when">
					<YearRange period={period} />
				</p>
				<p class="what">
					{href ? <a href={href}>{title}</a> : title}
					{org && <span class="org">·&nbsp;{org}</span>}
				</p>
				{where && <p class="where">{where}</p>}
				{note && <p class="note">{note}</p>}
			</li>
		))
	}
</ol>
