---
import type { Page } from "astro";

interface Props {
	page: Page;
	prevText?: string;
	nextText?: string;
}

const { page, prevText = "Previous", nextText = "Next" } = Astro.props;
const { prev, next } = page.url;
---

{
	(prev || next) && (
		<nav class="muted mt-14 flex justify-between gap-6">
			{prev ? <a href={prev}>{prevText}</a> : <span />}
			{next && <a href={next}>{nextText}</a>}
		</nav>
	)
}
