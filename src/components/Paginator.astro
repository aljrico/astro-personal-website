---
import type { Page } from "astro";

interface Props {
	page: Page;
	prevText?: string;
	nextText?: string;
}

const { page, prevText = "Previous", nextText = "Next" } = Astro.props;
const { prev, next } = page.url;
---

{
	(prev || next) && (
		<nav class="mt-8 flex items-center gap-x-4">
			{prev && (
				<a class="me-auto py-2 sm:hover:text-accent" href={prev} rel="prefetch">
					{prevText}
				</a>
			)}
			{next && (
				<a class="ms-auto py-2 sm:hover:text-accent" href={next} rel="prefetch">
					{nextText}
				</a>
			)}
		</nav>
	)
}
