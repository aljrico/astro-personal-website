---
import { ViewTransitions } from "astro:transitions";

import type { SiteMeta } from "@/types";
import BaseHead from "@/components/BaseHead";
import SkipLink from "@/components/SkipLink";
import SiteHeader from "@/components/SiteHeader";
import KonamiConfetti from "@/components/KonamiConfetti";
import { siteConfig } from "@/site-config";

interface Props {
	meta: SiteMeta;
}

const {
	meta: { title, description = siteConfig.description, ogImage, articleDate },
} = Astro.props;
---

<html lang={siteConfig.lang}>
	<head>
		<BaseHead title={title} description={description} ogImage={ogImage} articleDate={articleDate} />
		<ViewTransitions fallback="none" />
	</head>
	<body>
		<SkipLink />
		<div class="page">
			<header class="site-header">
				<SiteHeader />
				<slot name="header" />
			</header>
			<main id="main">
				<slot />
			</main>
		</div>
		<KonamiConfetti />
	</body>
</html>
