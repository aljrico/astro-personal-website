---
import { getCollection } from "astro:content";
import PageLayout from "@/layouts/Base";
import ProjectIcon from "@/components/app/ProjectIcon";
import { getProject, type LegalDoc } from "../data/projects";

type Props = {
	/** Key into src/data/projects.ts. */
	slug: string;
	description: string;
	/** Page <title>; defaults to the project title. */
	title?: string;
	/** Links shown before the legal docs. */
	navLinks?: Array<{ href: string; label: string }>;
};

const { slug, description, title, navLinks = [] } = Astro.props;
const project = getProject(slug);
const links = project.links ?? [];

const legalOrder: LegalDoc[] = ["privacy", "terms", "support"];
const legalLabels = project.legalLabels ?? {
	privacy: "Privacy Policy",
	terms: "Terms of Use",
	support: "Support",
	nav: `${project.title} links`,
};
const legalDocs = (await getCollection("apps", (entry) => entry.slug.startsWith(`${slug}/`)))
	.map((entry) => entry.slug.slice(slug.length + 1) as LegalDoc)
	.filter((doc) => legalOrder.includes(doc))
	.sort((a, b) => legalOrder.indexOf(a) - legalOrder.indexOf(b));
const nav = [
	...navLinks,
	...legalDocs.map((doc) => ({ href: `/apps/${slug}/${doc}`, label: legalLabels[doc] })),
];
---

<PageLayout meta={{ title: title ?? project.title, description }}>
	<header class="mb-14">
		<ProjectIcon icon={project.icon} alt="" loading="eager" class="mb-6 h-16 w-16 object-contain" />
		<h1>{project.title}</h1>
		<p class="muted">{project.subtitle ?? project.period}</p>
	</header>

	<div class="post-body">
		<slot />
	</div>

	{
		links.length > 0 && (
			<p class="mt-14">
				{links.map((link, i) => (
					<>
						{i > 0 && " · "}
						{link.disabled ? (
							<span class="muted">{link.label} (gone)</span>
						) : (
							<a href={link.href} target="_blank" rel="noopener noreferrer">
								{link.label}
							</a>
						)}
					</>
				))}
			</p>
		)
	}

	{
		nav.length > 0 && (
			<nav aria-label={legalLabels.nav} class="muted mt-14">
				{nav.map(({ href, label }, i) => (
					<>
						{i > 0 && " · "}
						<a href={href}>{label}</a>
					</>
				))}
			</nav>
		)
	}
</PageLayout>
