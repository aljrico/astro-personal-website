---
import type { CollectionEntry } from "astro:content";

import BaseLayout from "./Base.astro";
import FormattedDate from "@/components/FormattedDate";
import Prose from "@/components/blog/Prose";
import ScrollToTop from "@/components/blog/ScrollToTop";
import { siteConfig } from "@/site-config";

interface Props {
	entry: CollectionEntry<"devlog">;
}

const { entry } = Astro.props;
const {
	data: { title, description, publishDate },
} = entry;
const articleDate = publishDate.toISOString();
const { remarkPluginFrontmatter } = await entry.render();
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: title,
	description,
	datePublished: articleDate,
	author: { "@type": "Person", name: siteConfig.author, url: Astro.site?.href },
	url: canonicalURL.href,
	mainEntityOfPage: canonicalURL.href,
};
---

<BaseLayout meta={{ title, description, articleDate }}>
	<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	<article class="flex-grow break-words">
		<div data-hero>
			<h1 class="title mb-3 sm:mb-1">{title}</h1>
			<div class="flex flex-wrap items-center gap-x-3 gap-y-2">
				<p class="font-semibold">
					<FormattedDate date={publishDate} dateTimeOptions={{ month: "long" }} /> /{" "}
					{remarkPluginFrontmatter.minutesRead}
				</p>
			</div>
		</div>
		<Prose><slot /></Prose>
	</article>
	<ScrollToTop />
</BaseLayout>
