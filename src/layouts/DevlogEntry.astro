---
import type { CollectionEntry } from "astro:content";

import BaseLayout from "./Base.astro";
import FormattedDate from "@/components/FormattedDate";
import { siteConfig } from "@/site-config";

interface Props {
	entry: CollectionEntry<"devlog">;
}

const { entry } = Astro.props;
const {
	data: { title, description, publishDate },
} = entry;
const articleDate = publishDate.toISOString();
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: title,
	description,
	datePublished: articleDate,
	author: { "@type": "Person", name: siteConfig.author, url: Astro.site?.href },
	url: canonicalURL.href,
	mainEntityOfPage: canonicalURL.href,
};
---

<BaseLayout meta={{ title, description, articleDate }}>
	<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	<article>
		<header class="mb-14">
			<h1>{title}</h1>
			<p class="muted"><a href="/devlog/">Devlog</a> · <FormattedDate date={publishDate} /></p>
		</header>
		<div class="post-body">
			<slot />
		</div>
	</article>
</BaseLayout>
