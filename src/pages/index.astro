---
import PageLayout from "@/layouts/Base";
import EntryRow from "@/components/EntryRow";
import SectionIcon from "@/components/SectionIcon";
import { getAllPosts, sortMDByDate } from "@/utils";
import { siteConfig } from "@/site-config";
import { sections } from "../data/projects";

const latestPosts = sortMDByDate(await getAllPosts()).slice(0, 5);
// "2026-present" -> 2026 to now, "Feb-Oct 2022" -> 2022 alone, "2020-2024" stays as is.
const yearRange = (period: string) => {
	const years = period.match(/\d{4}/g) ?? [];
	const start = years[0] ?? "";
	const ongoing = /present/i.test(period);
	const end = ongoing ? "now" : years.at(-1);
	return { start, end: end && end !== start ? end : undefined, ongoing };
};

// One list, newest first; the section icon tells the kind of project apart.
const projects = sections
	.flatMap(({ icon, projects }) => projects.map((project) => ({ ...project, kind: icon })))
	.sort((a, b) => Number(yearRange(b.period).start) - Number(yearRange(a.period).start));
---

<PageLayout meta={{ title: siteConfig.title }} backLink={false}>
	<script
		is:inline
		type="application/ld+json"
		set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "Person",
			name: siteConfig.author,
			url: "https://aljrico.com",
			jobTitle: "Data Lead",
			description: "Data lead at a gaming studio. Game developer. Based near Barcelona.",
			sameAs: ["https://github.com/aljrico", "https://x.com/aljrico"],
		})}
	/>
	<section class="block">
		<h1 class="name">{siteConfig.author}</h1>
		<p class="mt-4">
			Data lead at a gaming studio. I also like studying companies and the stock market. When I'm
			not doing either, I make my own games. Based near Barcelona.
		</p>
	</section>
	<section class="block" aria-labelledby="label-projects">
		<h2 class="label" id="label-projects">Projects</h2>
		<ul class="rows">
			{
				projects.map(({ slug, title, period, kind }) => {
					const { start, end, ongoing } = yearRange(period);
					return (
						<li class="project">
							<SectionIcon name={kind} />
							<a class="what" href={`/apps/${slug}`}>
								{title}
							</a>
							<span class="status">
								{[start, end && "-", end && (ongoing ? <span class="now">{end}</span> : end)]}
							</span>
						</li>
					);
				})
			}
		</ul>
	</section>
	<section class="block" aria-labelledby="label-writing">
		<h2 class="label" id="label-writing">Writing</h2>
		<ul class="rows">
			{
				latestPosts.map((post) => (
					<EntryRow
						href={`/posts/${post.slug}/`}
						title={post.data.title}
						date={post.data.publishDate}
					/>
				))
			}
		</ul>
		<a class="indent" href="/posts/">All writing</a>
	</section>
	<footer class="footer">
		<a href="/cv/">CV</a> · <a href="https://github.com/aljrico">GitHub</a> ·{" "}
		<a href="https://x.com/aljrico">X</a>
	</footer>
</PageLayout>
