---
import PageLayout from "@/layouts/Base";
import EntryRow from "@/components/EntryRow";
import { getAllPosts, sortMDByDate } from "@/utils";
import { siteConfig } from "@/site-config";
import { sections } from "../data/projects";

const latestPosts = sortMDByDate(await getAllPosts()).slice(0, 5);
const startYear = (period: string) => period.match(/\d{4}/)?.[0] ?? "";
---

<PageLayout meta={{ title: siteConfig.title }} backLink={false}>
	<script
		is:inline
		type="application/ld+json"
		set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "Person",
			name: siteConfig.author,
			url: "https://aljrico.com",
			jobTitle: "Data Lead",
			description: "Data lead at a gaming studio. Game developer. Based near Barcelona.",
			sameAs: ["https://github.com/aljrico", "https://x.com/aljrico"],
		})}
	/>
	<section class="block">
		<h1>{siteConfig.author}</h1>
		{/* DRAFT: placeholder bio, Alejandro will rewrite it. */}
		<p class="mt-4" data-draft>
			Physicist by training, data lead in games. I make small games and write about companies. Since
			2014 I've started sixteen things; most of them ended.
		</p>
	</section>
	{
		sections.map(({ heading, projects }) => (
			<section class="block" aria-labelledby={`label-${heading}`}>
				<h2 class="label" id={`label-${heading}`}>
					{heading}
				</h2>
				<ul class="rows">
					{projects.map(({ slug, title, period, status }) => (
						<li>
							<span class="when">{startYear(period)}</span>
							<a class="what" href={`/apps/${slug}`}>
								{title}
							</a>
							<span class="status">{status}</span>
						</li>
					))}
				</ul>
			</section>
		))
	}
	<section class="block" aria-labelledby="label-writing">
		<h2 class="label" id="label-writing">Writing</h2>
		<ul class="rows">
			{
				latestPosts.map((post) => (
					<EntryRow
						href={`/posts/${post.slug}/`}
						title={post.data.title}
						date={post.data.publishDate}
					/>
				))
			}
		</ul>
		<a class="indent" href="/posts/">All writing</a>
	</section>
	<footer class="footer">
		<a href="/cv/">CV</a> · <a href="https://github.com/aljrico">GitHub</a> ·{" "}
		<a href="https://x.com/aljrico">X</a>
	</footer>
</PageLayout>
