---
import PageLayout from "@/layouts/Base";
import EntryRow from "@/components/EntryRow";
import SectionIcon from "@/components/SectionIcon";
import { getAllPosts, sortMDByDate, yearRange } from "@/utils";
import { siteConfig } from "@/site-config";
import { sections } from "../data/projects";
import type { SectionIconName } from "@/components/SectionIcon";

const latestPosts = sortMDByDate(await getAllPosts()).slice(0, 5);

const socials: Array<{ label: string; href: string; icon: SectionIconName }> = [
	{ label: "GitHub", href: "https://github.com/aljrico", icon: "github" },
	{ label: "LinkedIn", href: "https://www.linkedin.com/in/aljrico", icon: "linkedin" },
	{ label: "X", href: "https://x.com/aljrico", icon: "x" },
];

// One list, newest first; the section icon tells the kind of project apart.
const projects = sections
	.flatMap(({ icon, projects }) => projects.map((project) => ({ ...project, kind: icon })))
	.sort((a, b) => Number(yearRange(b.period).start) - Number(yearRange(a.period).start));
---

<PageLayout meta={{ title: siteConfig.title }}>
	<script
		is:inline
		type="application/ld+json"
		set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "Person",
			name: siteConfig.author,
			url: "https://aljrico.com",
			jobTitle: "Analytics Lead",
			description: "Analytics lead at a gaming studio. Game developer. Based near Barcelona.",
			sameAs: socials.map(({ href }) => href),
		})}
	/>
	<section class="block home-intro">
		<h1 class="sr-only">{siteConfig.author}</h1>
		<p>
			I run analytics for one of the most-played games on Roblox. Outside work I make small mobile
			games, run a public portfolio on <a href="https://etoro.tw/3Xxoov9" rel="sponsored noopener"
				>eToro</a
			>, write about tech companies and nerd out about science. Usually near Barcelona.
		</p>
		<nav class="socials" aria-label="Elsewhere">
			{
				socials.map(({ label, href, icon }) => (
					<a href={href} aria-label={label} title={label}>
						<SectionIcon name={icon} />
					</a>
				))
			}
		</nav>
	</section>
	<section class="block" aria-labelledby="label-projects">
		<h2 class="label" id="label-projects">Projects</h2>
		<ul class="rows">
			{
				projects.map(({ slug, title, period, kind }) => {
					const { start, end, ongoing } = yearRange(period);
					return (
						<li class:list={["iconed", { active: ongoing }]}>
							<SectionIcon name={kind} />
							<a class="what" href={`/apps/${slug}`}>
								{title}
							</a>
							<span class="status">
								{[start, end && "-", end && (ongoing ? <span class="now shimmer">{end}</span> : end)]}
							</span>
						</li>
					);
				})
			}
		</ul>
	</section>
	<section class="block" aria-labelledby="label-writing">
		<h2 class="label" id="label-writing"><a class="more" href="/posts/">Writing</a></h2>
		<ul class="rows">
			{
				latestPosts.map((post) => (
					<EntryRow
						href={`/posts/${post.slug}/`}
						title={post.data.title}
						date={post.data.publishDate}
					/>
				))
			}
		</ul>
	</section>
</PageLayout>

