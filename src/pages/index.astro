---
import SocialList from "@/components/SocialList";
import PostPreview from "@/components/blog/PostPreview";
import PageLayout from "@/layouts/Base";
import { getAllPosts, sortMDByDate } from "@/utils";

const MAX_POSTS = 10;
const allPosts = await getAllPosts();
const allPostsByDate = sortMDByDate(allPosts).slice(0, MAX_POSTS);

type Project = { title: string; date: string; href: string; icon: string };
const sections: Array<{ heading: string; projects: Project[] }> = [
	{
		heading: "Apps & Games",
		projects: [
			{
				title: "Tiny Crimes",
				date: "2026",
				href: "/apps/tiny-crimes",
				icon: "/tinyCrimesIcon.png",
			},
			{
				title: "Test DGT",
				date: "2026",
				href: "/apps/test-dgt",
				icon: "/testDgtIcon.png",
			},
			{
				title: "Mossos Coach",
				date: "2026",
				href: "/apps/flama-coach",
				icon: "/flamaIcon.png",
			},
			{
				title: "Match Tile: Mini",
				date: "2023",
				href: "/apps/match-tile-mini",
				icon: "/miniMatchIcon.png",
			},
			{
				title: "Cookie Empire",
				date: "2022",
				href: "/apps/cookie-empire",
				icon: "https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/5e/15/4a/5e154ae1-c4c9-0b05-187f-918de949abb3/AppIcon-0-0-1x_U007epad-0-0-0-1-0-0-85-220.png/128x128bb.jpg",
			},
			{
				title: "Pizza Clicker",
				date: "2022",
				href: "/apps/pizza-clicker",
				icon: "/pizzaClickerIcon.png",
			},
		],
	},
	{
		heading: "Open Source",
		projects: [
			{
				title: "toonlite",
				date: "2025",
				href: "/apps/toonlite",
				icon: "/toonlite_logo.svg",
			},
			{
				title: "rfinance",
				date: "2020-2024",
				href: "/apps/rfinance",
				icon: "/rfinance_logo.png",
			},
			{
				title: "tolkien",
				date: "2019",
				href: "/apps/tolkien",
				icon: "/tolkien_logo.svg",
			},
			{
				title: "planets",
				date: "2019",
				href: "/apps/planets",
				icon: "/planets_logo.png",
			},
			{
				title: "gameofthrones",
				date: "2018",
				href: "/apps/gameofthrones",
				icon: "/got_logo.png",
			},
			{
				title: "harrypotter",
				date: "2018",
				href: "/apps/harrypotter",
				icon: "/hp_logo.png",
			},
		],
	},
	{
		heading: "Ventures",
		projects: [
			{
				title: "Coffee Galley",
				date: "2020-2022",
				href: "/apps/coffee-galley",
				icon: "/ship_logo.png",
			},
			{
				title: "The Whale Coffee",
				date: "2020-2021",
				href: "/apps/the-whale-coffee",
				icon: "/whaleCoffeeIcon.png",
			},
			{
				title: "Comprar una tablet",
				date: "2014-2016",
				href: "/apps/comprar-una-tablet",
