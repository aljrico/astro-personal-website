---
import SocialList from "@/components/SocialList";
import PostPreview from "@/components/blog/PostPreview";
import PageLayout from "@/layouts/Base";
import ProjectIcon from "@/components/app/ProjectIcon";
import { getAllPosts, sortMDByDate } from "@/utils";
import { sections } from "../data/projects";

const MAX_POSTS = 10;
const allPosts = await getAllPosts();
const allPostsByDate = sortMDByDate(allPosts).slice(0, MAX_POSTS);
---

<PageLayout meta={{ title: "Home" }}>
	<script
		is:inline
		type="application/ld+json"
		set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "Person",
			name: "Alejandro Rico",
			url: "https://aljrico.com",
			jobTitle: "Data Lead",
			description: "Data lead at a gaming studio. Game developer. Based near Barcelona.",
			sameAs: ["https://github.com/aljrico"],
		})}
	/>
	<section>
		<p class="mb-4">
			Data lead at a gaming studio. I also like studying companies and the stock market. When I'm
			not doing either, I make my own games. Based near Barcelona.
		</p>
	</section>
	<section class="mt-10 sm:mt-12">
		<h2 class="title mb-6 text-xl">Side Projects</h2>
		{
			sections.map((section, sectionIndex) => (
				<div class="mb-8 last:mb-0">
					<h3 class="mb-3 text-xs font-semibold uppercase tracking-wider text-gray-500">
						{section.heading}
					</h3>
					<ul class="grid max-w-2xl grid-cols-[repeat(auto-fit,minmax(13.5rem,1fr))] gap-x-4 gap-y-1">
						{section.projects.map(({ slug, title, period, icon }) => (
							<li>
								<a
									href={`/apps/${slug}`}
									class="group -mx-2 flex items-center gap-3 rounded-lg px-2 py-2 transition-colors hover:bg-[#F0EEE9]"
								>
									<ProjectIcon
										icon={icon}
										alt=""
										loading={sectionIndex === 0 ? "eager" : "lazy"}
										class="h-10 w-10 shrink-0 rounded-[10px] object-contain shadow-sm ring-1 ring-black/5"
									/>
									<span class="relative">
										<span class="block font-[550] group-hover:underline">{title}</span>
										<span class="block text-xs text-gray-500">{period}</span>
									</span>
								</a>
							</li>
						))}
					</ul>
				</div>
			))
		}
	</section>
	<section aria-label="Blog post list" class="mt-10 sm:mt-12">
		<h2 class="title mb-4 text-xl">Posts</h2>
		<ul class="space-y-4 sm:space-y-2">
			{
				allPostsByDate.map((p) => (
					<li class="flex flex-col gap-x-2 sm:flex-row">
						<PostPreview post={p} />
					</li>
				))
			}
		</ul>
	</section>
	<section class="mt-10 sm:mt-12">
		<SocialList />
	</section>
</PageLayout>
