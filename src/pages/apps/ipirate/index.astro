---
import PageLayout from "@/layouts/Base";
import { Icon } from "astro-icon";

const meta = {
	title: "iPirate",
	description: "A League of Legends YouTube channel I ran from 2014 to 2017: daily pro games and montages.",
};
---

<PageLayout meta={meta}>
	<div class="max-w-2xl">
		<div class="mb-8 flex items-center gap-4">
			<img src="/ipirateIcon.svg" alt="iPirate channel icon" class="h-20 w-20 rounded-2xl" />
			<div>
				<h1 class="title mb-1 text-3xl">iPirate</h1>
				<p class="text-gray-500">2014-2017</p>
			</div>
		</div>

		<section class="mb-8">
			<p class="mb-4">
				A League of Legends YouTube Channel. The pitch was to upload pro player games every day and
				cut montages of the best competitive moments.
			</p>
			<p class="mb-4">
				It was my first attempt at making something for an audience instead of just for myself. I
				learned how much work is hidden behind "just post a video" and the importance of
				consistency.
			</p>
			<p class="mb-4">The channel is still up, but no longer active.</p>
		</section>

		<div class="mb-12 flex flex-wrap gap-3">
			<a
				href="https://www.youtube.com/@iPirateLoL/videos"
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center gap-2 rounded-md bg-accent px-4 py-2 text-bgColor transition-all hover:opacity-80"
			>
				<Icon name="fa-brands:youtube" class="h-5 w-5" />
				 YouTube
			</a>
		</div>
	</div>
</PageLayout>
