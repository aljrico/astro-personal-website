---
import PageLayout from "@/layouts/Base";
import { Icon } from "astro-icon";

const meta = {
	title: "rfinance",
	description: "An R package with a user-friendly set of tools for financial analysis.",
};
---

<PageLayout meta={meta}>
	<div class="max-w-2xl">
		<div class="mb-8 flex items-center gap-4">
			<img
				src="/rfinance_logo.png"
				alt="rfinance R package logo"
				class="h-20 w-20 rounded-2xl object-contain"
			/>
			<div>
				<h1 class="title mb-1 text-3xl">rfinance</h1>
				<p class="text-gray-500">2020-2024</p>
			</div>
		</div>

		<section class="mb-8">
			<p class="mb-4">
				A user-friendly toolkit for financial analysis in R. Pull prices and fundamentals, compute
				returns and ratios, build simple screens, without fighting five different APIs.
			</p>
			<p class="mb-4">
				It came out of my own stock research. The existing packages were either abandoned or needed
				a lot of ceremony for simple questions. This one tried to make the simple questions one
				line.
			</p>
		</section>

		<div class="mb-12 flex flex-wrap gap-3">
			<a
				href="https://github.com/aljrico/rfinance"
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center gap-2 rounded-md bg-accent px-4 py-2 text-bgColor transition-all hover:opacity-80"
			>
				<Icon name="fa-brands:github" class="h-5 w-5" />
				 GitHub
			</a>
			<a
				href="https://cran.r-project.org/package=rfinance"
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center gap-2 rounded-md bg-accent px-4 py-2 text-bgColor transition-all hover:opacity-80"
			>
				<Icon name="mdi:open-in-new" class="h-5 w-5" />
				 CRAN
			</a>
		</div>
	</div>
</PageLayout>
