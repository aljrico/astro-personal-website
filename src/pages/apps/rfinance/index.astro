---
import AppLanding from "@/layouts/AppLanding";

const meta = {
	title: "rfinance",
	description: "An R package with a user-friendly set of tools for financial analysis.",
};
---

<AppLanding slug="rfinance" {...meta}>
	<p class="mb-4">
		A user-friendly toolkit for financial analysis in R. Pull prices and fundamentals, compute
		returns and ratios, build simple screens, without fighting five different APIs.
	</p>
	<p class="mb-4">
		It came out of my own stock research. The existing packages were either abandoned or needed
		a lot of ceremony for simple questions. This one tried to make the simple questions one
		line.
	</p>
</AppLanding>
