---
import AppLanding from "@/layouts/AppLanding";

const meta = {
	title: "Tentatively",
	description:
		"Tentatively is a Tents and Trees logic puzzle game: pitch a tent beside every tree, with endless puzzles, five difficulties, three campsites and a daily challenge.",
};
---

<AppLanding slug="tentatively" {...meta}>
	<p class="mb-4">
		Pitch a tent next to every tree. The numbers on each row and column say how many tents go
		there. Tents never touch, not even diagonally. That's the whole game, and it gets clever fast.
	</p>
	<p>
		Every puzzle is generated and checked to have exactly one answer you can reach by pure
		deduction. Five difficulties, from a breezy 5x5 to a 12x12 Master grid, a daily challenge
		with one shared puzzle for everyone, and three campsites to unlock: a sunny meadow, a sandy
		desert of tall rocks and a valley of pink blossoms. Stuck? Hints explain the next logical
		step, not just where it goes.
	</p>
</AppLanding>
