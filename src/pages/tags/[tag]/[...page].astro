---
// Tags are no longer shown in the UI; these routes stay so old links still resolve.
import type { Page, GetStaticPaths } from "astro";
import type { CollectionEntry } from "astro:content";
import PageLayout from "@/layouts/Base";
import EntryRow from "@/components/EntryRow";
import Pagination from "@/components/Paginator";
import { getAllPosts, getUniqueTags, sortMDByDate } from "@/utils";

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
	const allPostsByDate = sortMDByDate(await getAllPosts());
	return getUniqueTags(allPostsByDate).flatMap((tag) =>
		paginate(
			allPostsByDate.filter((post) => post.data.tags.includes(tag)),
			{ params: { tag }, pageSize: 10 },
		),
	);
};

interface Props {
	page: Page<CollectionEntry<"post">>;
}

const { page } = Astro.props;
const { tag } = Astro.params;
---

<PageLayout meta={{ title: `Tag: ${tag}`, description: `Posts tagged ${tag}.` }}>
	<h1 class="mb-14">Tag: {tag}</h1>
	<ul class="rows">
		{
			page.data.map((post) => (
				<EntryRow href={`/posts/${post.slug}/`} title={post.data.title} date={post.data.publishDate} />
			))
		}
	</ul>
	<Pagination page={page} />
</PageLayout>
