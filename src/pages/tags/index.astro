---
// Tags are no longer shown in the UI; these routes stay so old links still resolve.
import PageLayout from "@/layouts/Base";
import { getAllPosts, getUniqueTagsWithCount } from "@/utils";

const allTags = getUniqueTagsWithCount(await getAllPosts());
---

<PageLayout meta={{ title: "Tags", description: "Topics Alejandro Rico has written about." }}>
	<h1 class="mb-14">Tags</h1>
	<ul class="rows">
		{
			allTags.map(([tag, count]) => (
				<li>
					<span class="when">{count}</span>
					<a class="what" href={`/tags/${tag}/`}>
						{tag}
					</a>
				</li>
			))
		}
	</ul>
</PageLayout>
