		<script type="module" is:inline>
			import * as Plot from "https://esm.sh/@observablehq/plot@0.6.17?bundle";
			import { summarizeBayesianMetrics } from "/scripts/bayesian-experiments.js";
			import { evaluateExperimentDecision } from "/scripts/experiment-decisions.js";

			const endpoint = "https://lbitxwhhrohcjkbpbcrv.supabase.co/functions/v1/verdoku-dashboard";
			// Telemetry before the 1.7.0 staged rollout completed is not trustworthy,
			// so nothing earlier than this UTC day is ever plotted. Mirrors the floor
			// in get_verdoku_dashboard_snapshot(); kept here so the page is correct
			// even against an older snapshot.
			const TRUSTED_FROM = "2026-07-01";
			const number = new Intl.NumberFormat("en", { maximumFractionDigits: 0 });
			const compact = new Intl.NumberFormat("en", {
				notation: "compact",
				maximumFractionDigits: 1,
			});
			const money = new Intl.NumberFormat("en", {
				style: "currency",
				currency: "USD",
				maximumFractionDigits: 0,
			});
			const preciseMoney = new Intl.NumberFormat("en", {
				style: "currency",
				currency: "USD",
				minimumFractionDigits: 3,
				maximumFractionDigits: 3,
			});
			const shortDate = new Intl.DateTimeFormat("en", { month: "short", day: "numeric" });
			const experimentDate = new Intl.DateTimeFormat("en", {
				month: "short",
				day: "numeric",
				year: "numeric",
			});
			const access = document.querySelector("#access");
			const boot = document.querySelector("#boot");
			const dashboard = document.querySelector("#dashboard");
			const form = document.querySelector("#access-form");
			const keyInput = document.querySelector("#access-key");
			const errorMessage = document.querySelector("#access-error");
			const liveStatus = document.querySelector("#live-status");
			const updatedAt = document.querySelector("#updated-at");
			const dashboardTitle = document.querySelector("#dashboard-title");
			const dashboardTabs = [...document.querySelectorAll("[data-dashboard-tab]")];
			const dashboardViews = [...document.querySelectorAll("[data-dashboard-view]")];
			const dashboardTabTitles = {
				overview: "The pulse.",
				aso: "App Store.",
				experiments: "The tests.",
			};
			let activeDashboardTab = "overview";
			let snapshot;
			let ratingSnapshot;
			let keywordSnapshot;
			let experimentSnapshot;
			let refreshTimer;
			let lastRenderedWidth = 0;
			const asoCache = new Map();
			const appStoreCountry = document.querySelector("#app-store-country");
			const keywordName = document.querySelector("#keyword-name");
			const experimentName = document.querySelector("#experiment-name");
			const experimentPlatform = document.querySelector("#experiment-platform");
			const experimentCountry = document.querySelector("#experiment-country");
			const competitorOptions = document.querySelector("#competitor-options");
			const competitorSummary = document.querySelector("#competitor-summary");
			const PRIMARY_APP_KEY = "murder_sudoku";
			const selectedCompetitorKeys = new Set(["enigmic"]);
			const competitorColors = ["#234766", "#2abd88", "#8d6bb1", "#d18a28", "#5b7894", "#8b5e3c"];
			const platformColor = {
				domain: ["iOS", "Android"],
				range: ["#5b7cfa", "#72b01d"],
			};
			let competitorApps = [];
			let competitorSignature = "";
			let experimentRosterSignature = "";
			let experimentCountrySignature = "";
			const experimentColors = new Map();

			// The access key used to live permanently in location.hash, which leaks it
			// into browser history, screenshots and screen shares. Private links still
			// work, but the hash is consumed once and stripped; the key lives in
			// localStorage from then on.
			const TOKEN_STORAGE_KEY = "verdoku-dashboard-key";

			function storedToken() {
				try {
					return localStorage.getItem(TOKEN_STORAGE_KEY) ?? "";
				} catch {
					return "";
				}
			}

			function storeToken(token) {
				try {
					localStorage.setItem(TOKEN_STORAGE_KEY, token);
				} catch {}
			}

			function forgetToken() {
				try {
					localStorage.removeItem(TOKEN_STORAGE_KEY);
				} catch {}
			}

			function consumeTokenFromHash() {
				let fromHash = "";
				try {
					fromHash = decodeURIComponent(location.hash.slice(1)).trim();
				} catch {}
				if (!fromHash) return "";
				history.replaceState(null, "", location.pathname + location.search);
				storeToken(fromHash);
				return fromHash;
			}

			function dashboardTabFromUrl() {
				const tab = new URL(location.href).searchParams.get("tab");
				return tab in dashboardTabTitles ? tab : "overview";
			}

			function renderActiveDashboardTab(token = storedToken()) {
				if (dashboard.hidden || !token) return;
				if (activeDashboardTab === "overview") {
					if (snapshot) render(snapshot);
				} else if (activeDashboardTab === "aso") {
					if (ratingSnapshot && keywordSnapshot) {
						renderRatings(ratingSnapshot);
						renderKeywordRank(keywordSnapshot);
					} else {
						void loadInitialAso(token);
					}
				} else if (experimentSnapshot) {
					renderExperiment(experimentSnapshot);
				} else {
					void loadInitialExperiments(token);
				}
			}

			function activateDashboardTab(tab, { updateHistory = false, renderView = true } = {}) {
				activeDashboardTab = tab in dashboardTabTitles ? tab : "overview";
				dashboardTitle.textContent = dashboardTabTitles[activeDashboardTab];

				for (const button of dashboardTabs) {
					const selected = button.dataset.dashboardTab === activeDashboardTab;
					button.setAttribute("aria-selected", String(selected));
					button.tabIndex = selected ? 0 : -1;
				}
				for (const view of dashboardViews) {
					view.hidden = view.dataset.dashboardView !== activeDashboardTab;
				}

				if (updateHistory) {
					const url = new URL(location.href);
					if (activeDashboardTab === "overview") url.searchParams.delete("tab");
					else url.searchParams.set("tab", activeDashboardTab);
					history.pushState(null, "", url);
				}

				if (renderView) requestAnimationFrame(() => renderActiveDashboardTab());
			}

			function renderHourlyPlayers(data) {
				const rows = (data.hourly_players ?? []).map((row) => ({
					...row,
					hour: new Date(row.hour),
					series: row.platform === "ios" ? "iOS" : "Android",
					players: Number(row.players),
				}));
				const node = document.querySelector("#hourly-players-plot");
				if (!rows.length) {
					node.replaceChildren();
					return;
				}
				const totals = new Map();
				for (const row of rows) {
					const key = row.hour.getTime();
					totals.set(key, (totals.get(key) ?? 0) + row.players);
				}
				for (const row of rows) row.total = totals.get(row.hour.getTime()) ?? 0;
				const width = node.clientWidth || 700;
				replacePlot(
					"#hourly-players-plot",
					Plot.plot({
						width,
						height: 210,
						marginTop: 34,
						marginRight: 12,
						marginBottom: 30,
						marginLeft: 43,
						style: { background: "transparent", color: "#7d8a96", fontSize: "10px" },
						x: {
							type: "utc",
							label: null,
							ticks: width < 500 ? 4 : 7,
							tickFormat: width < 500 ? "%a %Hh" : "%a %H:%M",
							tickSize: 0,
						},
						y: { label: null, grid: true, zero: true, ticks: 4, tickSize: 0 },
						color: { ...platformColor, legend: true },
						marks: [
							Plot.ruleY([0], { stroke: "#dfe5e8" }),
							Plot.rectY(
								rows,
								Plot.stackY({
									x: "hour",
									y: "players",
									interval: "hour",
									fill: "series",
									insetLeft: 1,
									insetRight: 1,
									tip: true,
									title: (row) =>
										`${row.hour.toLocaleString("en", {
											timeZone: "UTC",
											month: "short",
											day: "numeric",
											hour: "2-digit",
											minute: "2-digit",
											hour12: false,
										})} UTC · ${row.series}: ${number.format(row.players)} players` +
										(row.total ? ` (${((100 * row.players) / row.total).toFixed(1)}%)` : "") +
										(row.partial ? " · partial" : ""),
								}),
							),
						],
					}),
				);
			}

			function linePlot(source, field, color, tickFormat, options = {}) {
				const values = source.map((row) => Number(row[field])).filter(Number.isFinite);
				if (!values.length) return null;
				const min = Math.min(...values);
				const max = Math.max(...values);
				const padding = Math.max(
					(max - min) * 0.15,
					Math.max(Math.abs(min), Math.abs(max), 1) * 0.04,
				);
				const yDomain = [
					Math.max(options.floor ?? -Infinity, min - padding),
					Math.min(options.ceiling ?? Infinity, max + padding),
				];
				const latest = source[source.length - 1];
				return Plot.plot({
					width: options.width,
					height: options.height ?? 178,
					marginTop: 8,
					marginRight: 12,
					marginBottom: 28,
					marginLeft: options.marginLeft ?? 43,
					style: {
						background: "transparent",
						color: "#7d8a96",
						fontSize: options.fontSize ?? "10px",
					},
					x: {
						type: "utc",
						label: null,
						ticks: options.xTicks ?? 5,
						tickFormat: "%b %-d",
						tickSize: 0,
					},
					y: {
						domain: yDomain,
						label: null,
						grid: true,
						nice: true,
						ticks: 4,
						tickSize: 0,
						tickFormat,
					},
					marks: [
						Plot.areaY(source, {
							x: "date",
							y1: yDomain[0],
							y2: field,
							fill: color,
							fillOpacity: 0.1,
							curve: "monotone-x",
						}),
						Plot.lineY(source, {
							x: "date",
							y: field,
							stroke: color,
							strokeWidth: 2.2,
							curve: "monotone-x",
							tip: true,
							title:
								options.title ??
								((row) => `${shortDate.format(row.date)}: ${tickFormat(row[field])}`),
						}),
						Plot.dot([latest], { x: "date", y: field, fill: color, r: 3 }),
					],
				});
			}

			// "2026-07-12" -> "Jul 12", read as UTC so the label never slips a day.
			function dayLabel(day) {
				return typeof day === "string" ? shortDate.format(new Date(`${day}T12:00:00Z`)) : "";
			}

			// Authoritative peak over every trusted complete day, not the max of the
			// 30-day window the page happens to plot.
			function renderPeak(peak) {
				const note = document.querySelector("#dau-note");
				const value = Number(peak?.dau);
				note.textContent = Number.isFinite(value)
					? `DAU · peak ${number.format(value)} on ${dayLabel(peak.day)}`
					: "DAU";
				note.title = Number.isFinite(value) ? `Peak DAU across all trusted complete days.` : "";
			}

			function renderRetention(rows, series = []) {
				const parse = (row, dayN) => ({
					...row,
					date: new Date(`${row.cohort_day}T12:00:00Z`),
					day_n: Number(row.day_n ?? dayN),
					cohort_size: Number(row.cohort_size),
					returned: Number(row.returned),
					retention_pct: Number(row.retention_pct),
				});
				const parsed = rows.map((row) => parse(row));
				// Each entry of retention_series is cut at its own maturity horizon and
				// carries its window, so the panels can say which span they cover.
				const byDayN = new Map(
					(Array.isArray(series) ? series : [])
						.filter((entry) => Array.isArray(entry?.points))
						.map((entry) => [Number(entry.day_n), entry]),
				);
				const colors = {
					1: "#234766",
					3: "hsl(351deg 66% 48%)",
					7: "#d89024",
					14: "#2a9d8f",
				};

				for (const dayN of [1, 3, 7, 14]) {
					const entry = byDayN.get(dayN);
					const cohorts = entry
						? entry.points.map((point) => parse(point, dayN))
						: parsed.filter((row) => row.day_n === dayN);
					const latest = cohorts[cohorts.length - 1];
					const plotNode = document.querySelector(`#retention-d${dayN}-plot`);
					const noteNode = document.querySelector(`#retention-d${dayN}-note`);
					if (!latest) {
						noteNode.textContent = "not enough mature data";
						noteNode.title = "";
						plotNode.replaceChildren();
						continue;
					}
					noteNode.textContent = `${latest.retention_pct.toFixed(1)}%`;
					noteNode.title = entry
						? `Cohorts ${entry.cohort_from} to ${entry.cohort_to}, matured through ` +
						  `${entry.matured_through}. Pooled D${dayN} ${Number(
								entry.pooled_retention_pct,
						  ).toFixed(1)}%. Windows differ per checkpoint; compare only within this panel.`
						: "";
					const color = colors[dayN];
					replacePlot(
						`#retention-d${dayN}-plot`,
						linePlot(cohorts, "retention_pct", color, (value) => `${value.toFixed(0)}%`, {
							width: plotNode.clientWidth || 220,
							height: 150,
							marginLeft: 38,
							fontSize: "9px",
							xTicks: 3,
							floor: 0,
							ceiling: 100,
							title: (row) =>
								`${shortDate.format(row.date)}: ${row.retention_pct.toFixed(1)}% · ` +
								`${number.format(row.returned)} of ${number.format(row.cohort_size)}`,
						}),
					);
				}
			}

			function renderCohortRevenue(series = []) {
				const node = document.querySelector("#cohort-ltv-plot");
				const dayNs = [0, 3, 7, 14, 28];
				const rows = (Array.isArray(series) ? series : []).flatMap((entry) => {
					const dayN = Number(entry.day_n);
					if (!dayNs.includes(dayN) || !Array.isArray(entry?.points)) return [];
					return entry.points.map((point) => ({
						...point,
						date: new Date(`${point.cohort_day}T12:00:00Z`),
						series: `D${dayN}`,
						day_n: dayN,
						cohort_size: Number(point.cohort_size),
						value: Number(point.revenue_per_install_usd),
					}));
				});
				if (!rows.length) {
					node.replaceChildren();
					return;
				}

				replacePlot(
					"#cohort-ltv-plot",
					Plot.plot({
						width: node.clientWidth || 700,
						height: 210,
						marginTop: 34,
						marginRight: 12,
						marginBottom: 28,
						marginLeft: 48,
						style: { background: "transparent", color: "#7d8a96", fontSize: "10px" },
						x: { type: "utc", label: null, ticks: 5, tickFormat: "%b %-d", tickSize: 0 },
						y: {
							label: null,
							grid: true,
							zero: true,
							ticks: 5,
							tickSize: 0,
							tickFormat: preciseMoney.format,
						},
						color: {
							domain: dayNs.map((dayN) => `D${dayN}`),
							range: ["#9ecae1", "#6baed6", "#4292c6", "#2171b5", "#084594"],
							legend: true,
						},
						marks: [
							Plot.ruleY([0], { stroke: "#dfe5e8" }),
							Plot.lineY(rows, {
								x: "date",
								y: "value",
								z: "series",
								stroke: "series",
								strokeWidth: 2.2,
								curve: "monotone-x",
							}),
							Plot.dot(rows, {
								x: "date",
								y: "value",
								fill: "series",
								r: 2.5,
								tip: true,
								title: (row) =>
									`${shortDate.format(row.date)} · average ${row.series} LTV: ` +
									`${preciseMoney.format(row.value)} per user · ` +
									`${number.format(row.cohort_size)} users`,
							}),
						],
					}),
				);
			}

			function replacePlot(selector, plot) {
				document.querySelector(selector).replaceChildren(plot);
			}

			function setOptions(select, values, selected) {
				select.replaceChildren(
					...values.map((value) => {
						const option = document.createElement("option");
						option.value = value;
						option.textContent = value;
						option.selected = value === selected;
						return option;
					}),
				);
			}

			function updateCompetitorSummary() {
				const selected = competitorApps.filter((app) => selectedCompetitorKeys.has(app.app_key));
				competitorSummary.textContent =
					selected.length === 0
						? "Competitors"
						: selected.length === 1
						? selected[0].app_label
						: `${selected.length} competitors`;
			}

			function visibleAsoApps(data) {
				const visibleKeys = new Set([PRIMARY_APP_KEY, ...selectedCompetitorKeys]);
				return (data.apps ?? [{ app_key: PRIMARY_APP_KEY, app_label: "Murder Sudoku" }]).filter(
					(app) => visibleKeys.has(app.app_key),
				);
			}

			function appColor(appKey) {
				if (appKey === PRIMARY_APP_KEY) return "#bd2d47";
				const index = competitorApps.findIndex((app) => app.app_key === appKey);
				return competitorColors[index] ?? "#7d8a96";
			}

			function setCompetitorOptions(apps) {
				const competitors = (apps ?? []).filter((app) => app.app_key !== PRIMARY_APP_KEY);
				const signature = competitors
					.map((app) => `${app.app_key}\u0000${app.app_label}`)
					.join("\u0001");
				if (signature === competitorSignature) return;
				competitorSignature = signature;
				competitorApps = competitors;
				const availableKeys = new Set(competitors.map((app) => app.app_key));
				for (const key of selectedCompetitorKeys) {
					if (!availableKeys.has(key)) selectedCompetitorKeys.delete(key);
				}
				competitorOptions.replaceChildren(
					...competitors.map((app) => {
						const label = document.createElement("label");
						label.className = "competitor-option";
						const input = document.createElement("input");
						input.type = "checkbox";
						input.value = app.app_key;
						input.checked = selectedCompetitorKeys.has(app.app_key);
						input.addEventListener("change", () => {
							if (input.checked) selectedCompetitorKeys.add(app.app_key);
							else selectedCompetitorKeys.delete(app.app_key);
							updateCompetitorSummary();
							if (ratingSnapshot) renderRatings(ratingSnapshot);
							if (keywordSnapshot) renderKeywordRank(keywordSnapshot);
						});
						label.append(input, document.createTextNode(app.app_label));
						return label;
					}),
				);
				updateCompetitorSummary();
			}

			function renderRatings(data) {
				ratingSnapshot = data;
				setCompetitorOptions(data.apps);
				const rows = (data.ratings ?? []).map((row) => ({
					...row,
					app_key: row.app_key ?? PRIMARY_APP_KEY,
					app_label: row.app_label ?? "Murder Sudoku",
					date: new Date(`${row.day}T12:00:00Z`),
					rating: row.rating == null ? null : Number(row.rating),
					rating_count: row.rating_count == null ? null : Number(row.rating_count),
				}));
				const totalNode = document.querySelector("#total-ratings-plot");
				const selectedApps = visibleAsoApps(data);
				const visibleKeys = new Set(selectedApps.map((app) => app.app_key));
				const visibleRows = rows.filter(
					(row) => visibleKeys.has(row.app_key) && Number.isFinite(row.rating_count),
				);
				if (visibleRows.length) {
					replacePlot(
						"#total-ratings-plot",
						Plot.plot({
							width: totalNode.clientWidth || 320,
							height: 210,
							marginTop: 10,
							marginRight: 12,
							marginBottom: 28,
							marginLeft: 48,
							style: { background: "transparent", color: "#7d8a96", fontSize: "10px" },
							x: { type: "utc", label: null, ticks: 6, tickFormat: "%b %-d", tickSize: 0 },
							color: {
								domain: selectedApps.map((app) => app.app_label),
								range: selectedApps.map((app) => appColor(app.app_key)),
								legend: true,
							},
							y: {
								label: null,
								grid: true,
								nice: true,
								ticks: 4,
								tickSize: 0,
								tickFormat: number.format,
							},
							marks: [
								Plot.lineY(visibleRows, {
									x: "date",
									y: "rating_count",
									z: "app_key",
									stroke: "app_label",
									strokeWidth: 2.2,
									curve: "monotone-x",
									tip: true,
									title: (row) =>
										`${row.app_label} · ${shortDate.format(row.date)}: ${number.format(
											row.rating_count,
										)} ratings${Number.isFinite(row.rating) ? ` · ${row.rating.toFixed(2)}★` : ""}`,
								}),
								Plot.dot(visibleRows, { x: "date", y: "rating_count", fill: "app_label", r: 2.5 }),
							],
						}),
					);
				} else totalNode.replaceChildren();
				const primaryRows = rows.filter(
					(row) => row.app_key === PRIMARY_APP_KEY && Number.isFinite(row.rating_count),
				);
				const latest = primaryRows[primaryRows.length - 1];
				document.querySelector("#total-ratings-note").textContent = latest
					? `${number.format(latest.rating_count)}${
							Number.isFinite(latest.rating) ? ` · ${latest.rating.toFixed(2)}★` : ""
					  }`
					: "no data";
			}

			function renderKeywordRank(data) {
				keywordSnapshot = data;
				setCompetitorOptions(data.apps);
				const rows = (data.rankings ?? []).map((row) => {
					const searchLimit = Number(row.search_limit ?? data.search_limit ?? 200);
					const rank = row.rank == null ? null : Number(row.rank);
					return {
						...row,
						app_key: row.app_key ?? PRIMARY_APP_KEY,
						app_label: row.app_label ?? "Murder Sudoku",
						date: new Date(`${row.day}T12:00:00Z`),
						rank,
						search_limit: searchLimit,
					};
				});
				const node = document.querySelector("#keyword-rank-plot");
				if (!rows.length) {
					node.replaceChildren();
					document.querySelector("#keyword-rank-note").textContent = "no observations";
					return;
				}
				const visibleKeys = new Set([PRIMARY_APP_KEY, ...selectedCompetitorKeys]);
				const visibleRows = rows.filter((row) => visibleKeys.has(row.app_key));
				const selectedApps = visibleAsoApps(data);
				const limit = Math.max(...visibleRows.map((row) => row.search_limit));
				const rankedRows = visibleRows.filter((row) => Number.isFinite(row.rank));
				if (!rankedRows.length) {
					node.replaceChildren();
					document.querySelector(
						"#keyword-rank-note",
					).textContent = `${data.keyword} · ${data.country} · selected apps outside top ${limit}`;
					return;
				}
				const bestRank = Math.min(...rankedRows.map((row) => row.rank));
				const worstRank = Math.max(...rankedRows.map((row) => row.rank));
				const padding = Math.max(2, Math.ceil((worstRank - bestRank) * 0.15));
				const domainBest = Math.max(1, bestRank - padding);
				const domainWorst = Math.min(limit, worstRank + padding);
				replacePlot(
					"#keyword-rank-plot",
					Plot.plot({
						width: node.clientWidth || 700,
						height: 210,
						marginTop: 10,
						marginRight: 12,
						marginBottom: 28,
						marginLeft: 48,
						style: { background: "transparent", color: "#7d8a96", fontSize: "10px" },
						x: { type: "utc", label: null, ticks: 6, tickFormat: "%b %-d", tickSize: 0 },
						color: {
							domain: selectedApps.map((app) => app.app_label),
							range: selectedApps.map((app) => appColor(app.app_key)),
							legend: true,
						},
						y: {
							domain: [domainWorst, domainBest],
							label: null,
							grid: true,
							ticks: 6,
							tickSize: 0,
							tickFormat: (value) => `#${Math.round(value)}`,
						},
						marks: [
							Plot.ruleY(
								[10, 25, 50].filter((value) => value >= domainBest && value <= domainWorst),
								{
									stroke: "#d9dfe2",
									strokeDasharray: "3,3",
								},
							),
							Plot.lineY(visibleRows, {
								x: "date",
								y: "rank",
								z: "app_key",
								stroke: "app_label",
								strokeWidth: 2.2,
								curve: "monotone-x",
								tip: true,
								title: (row) => `${row.app_label} · ${shortDate.format(row.date)}: #${row.rank}`,
							}),
							Plot.dot(rankedRows, {
								x: "date",
								y: "rank",
								fill: "app_label",
								r: 2.5,
							}),
						],
					}),
				);
				const primaryRows = rows.filter((row) => row.app_key === PRIMARY_APP_KEY);
				const latest = primaryRows[primaryRows.length - 1];
				document.querySelector("#keyword-rank-note").textContent = `${data.keyword} · ${
					data.country
				} · Murder Sudoku ${
					latest?.rank == null ? `${latest?.search_limit ?? limit}+` : `#${latest.rank}`
				}`;
			}

			async function fetchAso(token, country, keyword) {
				const cacheKey = `${country}\u0000${keyword}`;
				if (asoCache.has(cacheKey)) return asoCache.get(cacheKey);
				const url = new URL(endpoint);
				url.searchParams.set("view", "aso");
				url.searchParams.set("country", country);
				url.searchParams.set("keyword", keyword);
				const response = await fetch(url, {
					headers: { Authorization: `Bearer ${token}` },
					cache: "no-store",
				});
				if (!response.ok) throw new Error("App Store history is unavailable.");
				const data = await response.json();
				asoCache.set(cacheKey, data);
				return data;
			}

			async function loadInitialAso(token) {
				try {
					const data = await fetchAso(token, "US", "sudoku");
					setOptions(appStoreCountry, data.countries, data.country);
					setOptions(keywordName, data.keywords, data.keyword);
					renderRatings(data);
					renderKeywordRank(data);
					const generated = new Date(data.generated_at);
					document.querySelector("#aso-updated").textContent = `collected ${shortDate.format(
						generated,
					)}`;
				} catch (error) {
					document.querySelector("#aso-updated").textContent = error.message;
				}
			}

			function labeledOptions(select, values, selected) {
				select.replaceChildren(
					...values.map(({ value, label }) => {
						const option = document.createElement("option");
						option.value = value;
						option.textContent = label;
						option.selected = value === selected;
						return option;
					}),
				);
			}

			function phaseLabel(phase) {
				return (
					{
						running: "Running",
						winner_rollout: "Winner rollout",
						stopped: "Stopped",
						draft: "Draft",
					}[phase] ?? phase
				);
			}

			function experimentColor(arm, index = 0) {
				if (!experimentColors.has(arm)) {
					experimentColors.set(arm, ["#234766", "hsl(351deg 66% 48%)"][index % 2]);
				}
				return experimentColors.get(arm);
			}

			function setExperimentControls(data) {
				const roster = data.roster ?? [];
				const rosterSignature = roster
					.map((row) => `${row.experiment_key}\u0000${row.title}\u0000${row.phase}`)
					.join("\u0001");
				if (rosterSignature !== experimentRosterSignature) {
					experimentRosterSignature = rosterSignature;
					labeledOptions(
						experimentName,
						roster.map((row) => ({
							value: row.experiment_key,
							label: `${row.title} · ${phaseLabel(row.phase)}`,
						})),
						data.experiment.experiment_key,
					);
				} else {
					experimentName.value = data.experiment.experiment_key;
				}

				if (!experimentPlatform.options.length) {
					labeledOptions(
						experimentPlatform,
						[
							{ value: "all", label: "All platforms" },
							{ value: "ios", label: "iOS" },
							{ value: "android", label: "Android" },
						],
						data.filters.platform,
					);
				} else experimentPlatform.value = data.filters.platform;

				const countries = ["all", ...(data.filters.countries ?? [])];
				const countrySignature = countries.join("\u0000");
				if (countrySignature !== experimentCountrySignature) {
					experimentCountrySignature = countrySignature;
					labeledOptions(
						experimentCountry,
						countries.map((country) => ({
							value: country,
							label: country === "all" ? "All countries" : country,
						})),
						data.filters.country,
					);
				} else experimentCountry.value = data.filters.country;
			}

			function experimentPlotStyle() {
				return { background: "transparent", color: "#7d8a96", fontSize: "10px" };
			}

			function renderExperimentHealth(data) {
				const chips = [];
				const rosterEntry = (data.roster ?? []).find(
					(row) => row.experiment_key === data.experiment.experiment_key,
				);
				if (rosterEntry?.config_health === "ok") chips.push(["Config matches lifecycle", "ok"]);
				else if (rosterEntry?.config_health === "not_installed")
					chips.push(["Not installed", "warn"]);
				else chips.push([`Config: ${rosterEntry?.config_health ?? "unknown"}`, "bad"]);

				const mismatches = Number(data.health?.mismatched_exposure_events ?? 0);
				chips.push(
					mismatches === 0
						? ["Exposure arms match", "ok"]
						: [`${number.format(mismatches)} arm mismatches`, "bad"],
				);

				const assignment = data.assignment ?? [];
				const assigned = assignment.reduce((sum, row) => sum + Number(row.assigned), 0);
				const deviation = assignment.reduce((max, row) => {
					const observed = assigned ? (100 * Number(row.assigned)) / assigned : 0;
					return Math.max(max, Math.abs(observed - Number(row.expected_pct)));
				}, 0);
				if (assigned) {
					chips.push([
						deviation <= 2 ? "Allocation balanced" : `Allocation off ${deviation.toFixed(1)}pp`,
						deviation <= 2 ? "ok" : "warn",
					]);
				}

				if (!data.health?.refreshed_at && data.experiment.phase !== "draft") {
					chips.push(["Initial backfill pending", "warn"]);
				}
				chips.push([
					data.bayesian_revision === 0
						? "Legacy · unversioned"
						: `Revision ${data.bayesian_revision ?? "pending"}`,
					data.bayesian_revision == null ? "warn" : "ok",
				]);

				const node = document.querySelector("#experiment-health");
				node.replaceChildren(
					...chips.map(([label, state]) => {
						const chip = document.createElement("span");
						chip.className = "health-chip";
						chip.dataset.state = state;
						chip.textContent = label;
						return chip;
					}),
				);
			}

			function formatExperimentEffect(value, unit, signed = true) {
				if (!Number.isFinite(value)) return "—";
				const sign = signed && value > 0 ? "+" : "";
				if (unit === "percent") return `${sign}${value.toFixed(2)}pp`;
				if (unit === "usd")
					return `${sign}$${value.toFixed(value < 0.01 && value > -0.01 ? 4 : 3)}`;
				return `${sign}${value.toFixed(2)}m`;
			}

			function renderExperimentDecision(data, metrics, decision) {
				const byKey = new Map(metrics.map((metric) => [metric.metric, metric]));
				const policy = data.decision_policy ?? {};
				const metric =
					byKey.get(decision.metric) ??
					byKey.get(policy.final?.metric) ??
					byKey.get(policy.early?.metric);
				const horizon = (
					decision.horizon ??
					metric?.horizon ??
					policy.final?.horizon ??
					""
				).toUpperCase();
				document.querySelector("#experiment-probability-label").textContent = horizon
					? `P(treatment > control) · ${horizon}`
					: "P(treatment > control)";
				document.querySelector("#experiment-lift-label").textContent = horizon
					? `Expected lift · ${horizon}`
					: "Expected lift";
				document.querySelector("#experiment-probability").textContent = metric
					? `${(100 * metric.effect.probability_better).toFixed(1)}%`
					: "—";
				document.querySelector("#experiment-probability-note").textContent = metric
					? `${metric.arms.map((arm) => `${arm.arm} n=${number.format(arm.n)}`).join(" · ")}`
					: "complete cohort snapshot pending";
				const relative = metric?.effect.relative_pct;
				document.querySelector("#experiment-lift").textContent = Number.isFinite(relative)
					? `${relative > 0 ? "+" : ""}${relative.toFixed(1)}%`
					: metric
					? formatExperimentEffect(metric.effect.value, metric.unit)
					: "—";
				document.querySelector("#experiment-lift-note").textContent = metric
					? `${formatExperimentEffect(
							metric.effect.value,
							metric.unit,
					  )} · 95% CrI ${formatExperimentEffect(
							metric.effect.ci_low,
							metric.unit,
					  )} to ${formatExperimentEffect(metric.effect.ci_high, metric.unit)}`
					: "treatment − control";
				document.querySelector("#experiment-risk").textContent = metric
					? `${formatExperimentEffect(
							metric.effect.expected_loss_treatment,
							metric.unit,
							false,
					  )} / ${formatExperimentEffect(metric.effect.expected_loss_control, metric.unit, false)}`
					: "—";
				document.querySelector("#experiment-risk-note").textContent =
					"choosing treatment · choosing control";

				const labels = {
					insufficient_data: "Waiting for data",
					keep_running: "Keep running",
					ship_treatment: "Treatment looks shippable",
					keep_control: "Keep control",
					practical_tie: "Practical tie",
					guardrail_blocked: "Guardrail blocks treatment",
				};
				const decisionStat = document.querySelector("#experiment-decision-stat");
				decisionStat.dataset.state = decision.state;
				document.querySelector("#experiment-decision").textContent =
					labels[decision.state] ?? "Waiting for data";
				const threshold = Number(decision.loss_threshold);
				document.querySelector("#experiment-decision-reason").textContent =
					decision.state === "insufficient_data"
						? decision.reason
						: decision.state === "guardrail_blocked"
						? `${decision.blocked_by.metric.replaceAll("_", " ")} crossed its harm threshold`
						: `${
								decision.timing === "early" ? "D7 fast path" : "D14 final read"
						  } · loss threshold ${
								Number.isFinite(threshold) ? `$${threshold.toFixed(3)}/user` : "pending"
						  }`;
				document.querySelector("#experiment-decision-note").textContent =
					"recommendation only · no experiment setting changes automatically";
			}

			function renderExperimentEffects(metrics, decision) {
				const byKey = new Map(metrics.map((metric) => [metric.metric, metric]));
				const groups = [
					{
						title: "Retention · lift in percentage points",
						metrics: ["d1_retention", "d3_retention", "d7_retention", "d14_retention"],
					},
					{
						title: "Cumulative playtime per exposed player · lift in minutes",
						metrics: ["d0_playtime", "d1_playtime", "d3_playtime", "d7_playtime", "d14_playtime"],
					},
					{
						title: "Estimated net LTV per exposed player · lift in USD",
						metrics: ["d0_ltv", "d1_ltv", "d3_ltv", "d7_ltv", "d14_ltv"],
					},
					{ title: "Post-decision audit", metrics: ["d30_ltv"] },
				];
				const root = document.querySelector("#experiment-effects");
				root.replaceChildren(
					...groups.map((group) => {
						const section = document.createElement("section");
						section.className = "experiment-effect-group";
						const heading = document.createElement("h4");
						heading.className = "experiment-effect-heading";
						heading.textContent = group.title;
						const available = group.metrics.map((key) => byKey.get(key)).filter(Boolean);
						const scale = Math.max(
							...available.flatMap((metric) => [
								Math.abs(metric.effect.ci_low),
								Math.abs(metric.effect.ci_high),
							]),
							Number.EPSILON,
						);
						const rows = group.metrics.map((key) => {
							const summary = byKey.get(key);
							const row = document.createElement("div");
							row.className = "experiment-effect-row";
							if (key === decision.metric) row.dataset.role = "primary";
							const horizon = document.createElement("span");
							horizon.className = "experiment-effect-horizon";
							horizon.textContent = key.split("_")[0].toUpperCase();
							const probability = document.createElement("span");
							probability.className = "experiment-effect-probability";
							if (!summary) {
								probability.textContent = "—";
								const pending = document.createElement("span");
								pending.className = "experiment-effect-pending";
								pending.textContent = "Complete cohort snapshot pending";
								row.append(horizon, probability, pending);
								return row;
							}
							const pBetter = 100 * summary.effect.probability_better;
							probability.textContent = `${pBetter.toFixed(0)}%`;
							probability.dataset.strong = pBetter >= 90 ? "true" : "false";
							const track = document.createElement("span");
							track.className = "experiment-effect-track";
							const zero = document.createElement("span");
							zero.className = "experiment-effect-zero";
							const position = (value) => 50 + 45 * Math.max(-1, Math.min(1, value / scale));
							const low = position(summary.effect.ci_low);
							const high = position(summary.effect.ci_high);
							const interval = document.createElement("span");
							interval.className = "experiment-effect-interval";
							interval.style.left = `${Math.min(low, high)}%`;
							interval.style.width = `${Math.abs(high - low)}%`;
							const dot = document.createElement("span");
							dot.className = "experiment-effect-dot";
							dot.style.left = `${position(summary.effect.value)}%`;
							track.append(zero, interval, dot);
							const value = document.createElement("span");
							value.className = "experiment-effect-value";
							value.textContent = formatExperimentEffect(summary.effect.value, summary.unit);
							row.title =
								`${summary.label}: ${formatExperimentEffect(
									summary.effect.value,
									summary.unit,
								)} · ` +
								`95% credible interval ${formatExperimentEffect(
									summary.effect.ci_low,
									summary.unit,
								)} to ` +
								`${formatExperimentEffect(summary.effect.ci_high, summary.unit)} · ` +
								summary.arms.map((arm) => `${arm.arm} n=${number.format(arm.n)}`).join(" · ");
							row.append(horizon, probability, track, value);
							return row;
						});
						section.append(heading, ...rows);
						return section;
					}),
				);
			}

			function renderExperiment(data) {
				experimentSnapshot = data;
				experimentColors.clear();
				setExperimentControls(data);

				const experiment = data.experiment;
				document.querySelector("#experiment-title").textContent = experiment.title;
				const phase = document.querySelector("#experiment-phase");
				phase.textContent = phaseLabel(experiment.phase);
				phase.dataset.phase = experiment.phase;
				document.querySelector("#experiment-metric-copy").textContent =
					"Bayesian readout: retention, cumulative playtime, and estimated net LTV. Recommendations remain yours to accept or reject." +
					(experiment.winner_arm ? ` Winner: ${experiment.winner_arm}.` : "");

				const assignment = (data.assignment ?? []).map((row, index) => ({
					...row,
					index,
					assigned: Number(row.assigned),
					exposed: Number(row.exposed),
					expected_pct: Number(row.expected_pct),
				}));
				const totalAssigned = Number(data.assigned_total ?? 0);
				const totalExposed = assignment.reduce((sum, row) => sum + row.exposed, 0);
				const startedAt = experiment.activation_at ? new Date(experiment.activation_at) : null;
				const scheduledEnd = experiment.enrollment_end_at
					? new Date(experiment.enrollment_end_at)
					: null;
				const elapsedUntil = scheduledEnd && scheduledEnd < new Date() ? scheduledEnd : new Date();
				const daysRunning = startedAt
					? Math.max(1, Math.ceil((elapsedUntil.getTime() - startedAt.getTime()) / 86_400_000))
					: 0;
				document.querySelector("#experiment-exposed").textContent = compact.format(totalExposed);
				document.querySelector("#experiment-assigned").textContent = compact.format(totalAssigned);
				document.querySelector("#experiment-days").textContent = startedAt
					? number.format(daysRunning)
					: "—";
				const datesNode = document.querySelector("#experiment-dates");
				datesNode.textContent = startedAt
					? `${experimentDate.format(startedAt)} – ${
							scheduledEnd ? experimentDate.format(scheduledEnd) : "ongoing"
					  }`
					: "Not started";
				renderExperimentHealth(data);

				const allocationRows = assignment.flatMap((row) => [
					{
						arm: row.arm,
						label: `${row.arm} · assigned`,
						measure: "Assigned",
						value: row.assigned,
					},
					{ arm: row.arm, label: `${row.arm} · exposed`, measure: "Exposed", value: row.exposed },
				]);
				const allocationNode = document.querySelector("#experiment-allocation-plot");
				if (allocationRows.some((row) => row.value > 0)) {
					replacePlot(
						"#experiment-allocation-plot",
						Plot.plot({
							width: allocationNode.clientWidth || 320,
							height: 178,
							marginTop: 8,
							marginRight: 10,
							marginBottom: 28,
							marginLeft: 126,
							style: experimentPlotStyle(),
							x: { label: null, grid: true, ticks: 4, tickSize: 0 },
							y: { label: null, tickSize: 0 },
							color: {
								domain: ["Assigned", "Exposed"],
								range: ["#aab5bd", "#234766"],
								legend: true,
							},
							marks: [
								Plot.barX(allocationRows, {
									x: "value",
									y: "label",
									fill: "measure",
									tip: true,
									title: (row) => `${row.label}: ${number.format(row.value)}`,
								}),
							],
						}),
					);
				} else allocationNode.replaceChildren();
				document.querySelector("#experiment-allocation-note").textContent =
					"assigned: active 3d · exposed: experiment-to-date";

				const posteriorMetrics = summarizeBayesianMetrics(data.bayesian_inputs ?? [], {
					controlArm: experiment.control_arm,
					treatmentArm: experiment.treatment_arm,
					draws: 8000,
					seed:
						`${experiment.experiment_key}|${data.filters?.platform}|${data.filters?.country}|` +
						`${data.bayesian_revision}|${data.bayesian_refreshed_at}`,
				});
				const decision = evaluateExperimentDecision(posteriorMetrics, data.decision_policy);
				renderExperimentDecision(data, posteriorMetrics, decision);
				renderExperimentEffects(posteriorMetrics, decision);

				const funnel = (data.funnel ?? []).flatMap((armRow, index) =>
					(armRow.stages ?? []).map((stage) => ({
						...stage,
						arm: armRow.arm,
						index,
						label: `${stage.label} · ${armRow.arm}`,
						count: Number(stage.count),
						rate_pct: stage.rate_pct == null ? 0 : Number(stage.rate_pct),
					})),
				);
				const funnelNode = document.querySelector("#experiment-funnel-plot");
				if (funnel.some((row) => row.count > 0)) {
					replacePlot(
						"#experiment-funnel-plot",
						Plot.plot({
							width: funnelNode.clientWidth || 320,
							height: Math.max(190, funnel.length * 25 + 35),
							marginTop: 8,
							marginRight: 12,
							marginBottom: 28,
							marginLeft: 160,
							style: experimentPlotStyle(),
							x: {
								domain: [0, 100],
								label: null,
								grid: true,
								tickFormat: (value) => `${value}%`,
								tickSize: 0,
							},
							y: { label: null, tickSize: 0 },
							marks: [
								Plot.barX(funnel, {
									x: "rate_pct",
									y: "label",
									fill: (row) => experimentColor(row.arm, row.index),
									tip: true,
									title: (row) =>
										`${row.label}: ${row.rate_pct.toFixed(1)}% · ${number.format(
											row.count,
										)} players`,
								}),
							],
						}),
					);
				} else funnelNode.replaceChildren();

				const guardrails = (data.guardrails ?? [])
					.map((row) => ({
						...row,
						metric:
							experiment.experiment_key === "hint_offer_choice" &&
							row.metric === "Cancellation rate"
								? "Dismissal / cancellation"
								: row.metric,
						n: Number(row.n),
						rate_pct: row.rate_pct == null ? null : Number(row.rate_pct),
						index: row.arm === experiment.control_arm ? 0 : 1,
					}))
					.filter((row) => Number.isFinite(row.rate_pct));
				const guardrailNode = document.querySelector("#experiment-guardrail-plot");
				if (guardrails.length) {
					replacePlot(
						"#experiment-guardrail-plot",
						Plot.plot({
							width: guardrailNode.clientWidth || 320,
							height: 230,
							marginTop: 12,
							marginRight: 12,
							marginBottom: 30,
							marginLeft: 105,
							style: experimentPlotStyle(),
							x: { label: null, grid: true, tickFormat: (value) => `${value}%`, tickSize: 0 },
							y: { label: null, tickSize: 0 },
							marks: [
								Plot.dot(guardrails, {
									x: "rate_pct",
									y: "metric",
									fill: (row) => experimentColor(row.arm, row.index),
									symbol: (row) => (row.index === 0 ? "circle" : "diamond"),
									r: 5,
									tip: true,
									title: (row) =>
										`${row.metric} · ${row.arm}: ${row.rate_pct.toFixed(1)}% · n=${number.format(
											row.n,
										)}`,
								}),
							],
						}),
					);
				} else guardrailNode.replaceChildren();

				const refreshed =
					data.bayesian_refreshed_at ?? data.health?.refreshed_at ?? data.generated_at;
				document.querySelector("#experiment-updated").textContent = refreshed
					? `posterior ${shortDate.format(new Date(refreshed))}`
					: "backfill pending";
			}

			async function fetchExperiment(token, experiment, platform, country) {
				const url = new URL(endpoint);
				url.searchParams.set("view", "experiments");
				url.searchParams.set("experiment", experiment);
				url.searchParams.set("platform", platform);
				url.searchParams.set("country", country);
				const response = await fetch(url, {
					headers: { Authorization: `Bearer ${token}` },
					cache: "no-store",
				});
				if (!response.ok) throw new Error("Experiment results are unavailable.");
				return response.json();
			}

			async function loadInitialExperiments(token) {
				try {
					const data = await fetchExperiment(token, "hint_offer_choice", "all", "all");
					renderExperiment(data);
				} catch (error) {
					document.querySelector("#experiment-updated").textContent = error.message;
				}
			}

			async function refreshExperimentSelection() {
				if (!experimentName.value) return;
				try {
					document.querySelector("#experiment-updated").textContent = "loading…";
					const data = await fetchExperiment(
						storedToken(),
						experimentName.value,
						experimentPlatform.value || "all",
						experimentCountry.value || "all",
					);
					renderExperiment(data);
				} catch (error) {
					document.querySelector("#experiment-updated").textContent = error.message;
				}
			}

			function renderPlots(data) {
				const rows = data.series.map((row) => {
					const dau = Number(row.dau);
					const newPlayers = Math.min(dau, Number(row.new_installs));
					const iapRevenue = Number(row.iap_revenue_usd ?? 0);
					const adRevenue = Number(row.ad_revenue_usd ?? 0);
					const iosRevenue = Number(row.ios_revenue_usd ?? 0);
					const androidRevenue = Number(row.android_revenue_usd ?? 0);
					const revenue = Number(row.revenue_usd ?? iapRevenue + adRevenue);
					return {
						...row,
						date: new Date(`${row.day}T12:00:00Z`),
						dau,
						ios_dau: Number(row.ios_dau),
						android_dau: Number(row.android_dau),
						new_players: newPlayers,
						existing_players: Math.max(0, dau - newPlayers),
						sessions_per_player: dau ? Number(row.sessions) / dau : 0,
						cases_per_player: dau ? Number(row.cases_solved) / dau : 0,
						daily_pct:
							row.daily_participation_pct == null ? null : Number(row.daily_participation_pct),
						xp_per_player: dau ? Number(row.xp_earned) / dau : 0,
						iap_revenue_usd: iapRevenue,
						ad_revenue_usd: adRevenue,
						ios_revenue_usd: iosRevenue,
						android_revenue_usd: androidRevenue,
						revenue_usd: revenue,
						arpdau_usd: dau ? revenue / dau : 0,
						conversion_pct: dau ? (100 * Number(row.payers)) / dau : 0,
						arppu_usd: Number(row.payers) ? revenue / Number(row.payers) : 0,
						ads_per_dau: dau ? Number(row.ad_impressions) / dau : 0,
						country_dau: Array.isArray(row.country_dau) ? row.country_dau : [],
					};
				});
				const playerMix = rows.flatMap((row) => [
					{ ...row, series: "Existing", value: row.existing_players },
					{ ...row, series: "New", value: row.new_players },
				]);
				const revenueBySource = rows.flatMap((row) => [
					{ ...row, series: "IAP", value: row.iap_revenue_usd, total: row.revenue_usd },
					{ ...row, series: "Ads", value: row.ad_revenue_usd, total: row.revenue_usd },
				]);
				const revenueByPlatform = rows.flatMap((row) => {
					const total = row.ios_revenue_usd + row.android_revenue_usd;
					return [
						{ ...row, series: "iOS", value: row.ios_revenue_usd, total },
						{ ...row, series: "Android", value: row.android_revenue_usd, total },
					];
				});
				const revenueSourceLabels = {
					ads: "Ads",
					remove_ads: "Remove Ads",
					hints: "Hints",
					islands: "Dead Man's Cove",
					grove: "Grove in Pink",
					farmyard: "Farmyard",
					other_iap: "Other IAP",
				};
				const rawRevenueSources = (data.revenue_sources ?? []).map((row) => ({
					day: row.day,
					source: row.source,
					value: Number(row.revenue_usd),
				}));
				const availableRevenueSources = new Set(rawRevenueSources.map((row) => row.source));
				const preferredRevenueSources = [
					"ads",
					"remove_ads",
					"hints",
					"islands",
					"grove",
					"farmyard",
					"other_iap",
				];
				const revenueSourceKeys = [
					...preferredRevenueSources.filter((key) => availableRevenueSources.has(key)),
					...[...availableRevenueSources]
						.filter((key) => !preferredRevenueSources.includes(key))
						.sort(),
				];
				const revenueSourceValues = new Map(
					rawRevenueSources.map((row) => [`${row.day}:${row.source}`, row.value]),
				);
				const revenueSourceDays = rows.filter((row) => row.day >= "2026-07-14");
				const revenueSources = revenueSourceDays.flatMap((day) => {
					const values = revenueSourceKeys.map((source) => ({
						date: day.date,
						day: day.day,
						source,
						series: revenueSourceLabels[source] ?? source,
						value: revenueSourceValues.get(`${day.day}:${source}`) ?? 0,
					}));
					const total = values.reduce((sum, row) => sum + row.value, 0);
					return values.map((row) => ({
						...row,
						total,
						share: total ? row.value / total : 0,
					}));
				});
				const caseBreakdowns = (data.case_breakdowns ?? []).map((row) => ({
					...row,
					date: new Date(`${row.day}T12:00:00Z`),
				}));
				const breakdownSeries = (field, labels, preferredKeys) => {
					const availableKeys = new Set(
						caseBreakdowns.flatMap((day) => (day[field] ?? []).map((entry) => entry.key)),
					);
					const keys = [
						...preferredKeys.filter((key) => availableKeys.has(key)),
						...[...availableKeys].filter((key) => !preferredKeys.includes(key)).sort(),
					];
					return {
						keys,
						domain: keys.map((key) => labels[key] ?? key),
						rows: caseBreakdowns.flatMap((day) => {
							const counts = new Map(
								(day[field] ?? []).map((entry) => [entry.key, Number(entry.cases_solved)]),
							);
							const total = [...counts.values()].reduce((sum, value) => sum + value, 0);
							return keys.map((key) => ({
								date: day.date,
								series: labels[key] ?? key,
								value: counts.get(key) ?? 0,
								total,
								share: total ? (counts.get(key) ?? 0) / total : 0,
							}));
						}),
					};
				};
				const environments = breakdownSeries(
					"environments",
					{
						nextDoor: "Next Door",
						islands: "Dead Man's Cove",
						grove: "Grove in Pink",
						farmyard: "Farmyard",
						unknown: "Unknown",
					},
					["nextDoor", "islands", "grove", "farmyard", "unknown"],
				);
				const difficulties = breakdownSeries(
					"difficulties",
					{ easy: "Easy", medium: "Medium", hard: "Hard", free: "Free", unknown: "Unknown" },
					["easy", "medium", "hard", "free", "unknown"],
				);
				const platformDays = rows.filter((row) => row.ios_dau + row.android_dau > 0);
				const platform = platformDays.flatMap((row) => {
					const total = row.ios_dau + row.android_dau;
					return [
						{ ...row, series: "iOS", value: row.ios_dau, total },
						{ ...row, series: "Android", value: row.android_dau, total },
					];
				});
				const countries = rows.flatMap((row) =>
					row.country_dau.map((country) => ({
						...row,
						series: country.country,
						value: Number(country.dau),
					})),
				);
				const countryDomain = [...new Set(countries.map((row) => row.series))].filter(
					(country) => country !== "Others",
				);
				if (countries.some((row) => row.series === "Others")) countryDomain.push("Others");
				const countryPalette = [
					"#2a9d8f",
					"#7b61a8",
					"#e76f51",
					"#3a86a8",
					"#9c6644",
					"#8f9f3a",
					"#d65d9e",
					"#4f772d",
					"#6d597a",
				];
				const countryRange = countryDomain.map((country, index) =>
					country === "Others" ? "#b8c0c7" : countryPalette[index % countryPalette.length],
				);

				const latestPlatform = platformDays[platformDays.length - 1];
				if (latestPlatform) {
					const total = latestPlatform.ios_dau + latestPlatform.android_dau;
					document.querySelector("#platform-note").textContent =
						`iOS ${((100 * latestPlatform.ios_dau) / total).toFixed(1)}% · ` +
						`Android ${((100 * latestPlatform.android_dau) / total).toFixed(1)}%`;
				}
				const latestRow = rows[rows.length - 1];
				const latestCountries = latestRow?.country_dau
					.filter((country) => country.country !== "Others")
					.map((country) => country.country);
				document.querySelector("#country-note").textContent = latestCountries?.length
					? `${dayLabel(latestRow.day)}: ${latestCountries.join(" · ")} · others`
					: "daily top 3 · others";

				const bars = (selector, source, options = {}) =>
					replacePlot(
						selector,
						Plot.plot({
							width: document.querySelector(selector).clientWidth || 700,
							height: 190,
							marginTop: options.legend ? 34 : 8,
							marginRight: 12,
							marginBottom: 28,
							marginLeft: 43,
							style: { background: "transparent", color: "#7d8a96", fontSize: "10px" },
							x: { type: "utc", label: null, ticks: 5, tickFormat: "%b %-d", tickSize: 0 },
							y: {
								label: null,
								grid: true,
								zero: true,
								ticks: 4,
								tickSize: 0,
								tickFormat: options.tickFormat ?? compact.format,
							},
							color: options.color,
							marks: [
								Plot.ruleY([0], { stroke: "#dfe5e8" }),
								Plot.rectY(
									source,
									options.stacked
										? Plot.stackY({
												x: "date",
												y: "value",
												fill: "series",
												interval: "day",
												insetLeft: 1.2,
												insetRight: 1.2,
												tip: true,
												title: options.title,
										  })
										: {
												x: "date",
												y: options.y,
												interval: "day",
												fill: options.fill,
												insetLeft: 1.2,
												insetRight: 1.2,
												tip: true,
												title: options.title,
										  },
								),
							],
						}),
					);

				bars("#dau-plot", rows, {
					y: "dau",
					fill: "#234766",
					title: (row) => `${shortDate.format(row.date)}: ${number.format(row.dau)} DAU`,
				});
				bars("#player-mix-plot", playerMix, {
					stacked: true,
					legend: true,
					color: { domain: ["Existing", "New"], range: ["#d89024", "#bd2d47"], legend: true },
					title: (row) => `${row.series}: ${number.format(row.value)}`,
				});
				const playerMixLinesNode = document.querySelector("#player-mix-lines-plot");
				replacePlot(
					"#player-mix-lines-plot",
					Plot.plot({
						width: playerMixLinesNode.clientWidth || 320,
						height: 190,
						marginTop: 34,
						marginRight: 12,
						marginBottom: 28,
						marginLeft: 43,
						style: { background: "transparent", color: "#7d8a96", fontSize: "10px" },
						x: { type: "utc", label: null, ticks: 5, tickFormat: "%b %-d", tickSize: 0 },
						y: { label: null, grid: true, zero: true, ticks: 4, tickSize: 0 },
						color: {
							domain: ["Existing", "New"],
							range: ["#d89024", "#bd2d47"],
							legend: true,
						},
						marks: [
							Plot.ruleY([0], { stroke: "#dfe5e8" }),
							Plot.lineY(playerMix, {
								x: "date",
								y: "value",
								stroke: "series",
								strokeWidth: 2.2,
								curve: "monotone-x",
								tip: true,
								title: (row) =>
									`${shortDate.format(row.date)} · ${row.series}: ${number.format(row.value)}`,
							}),
						],
					}),
				);
				bars("#country-plot", countries, {
					stacked: true,
					legend: true,
					color: { domain: countryDomain, range: countryRange, legend: true },
					title: (row) => `${row.series}: ${number.format(row.value)}`,
				});
				bars("#platform-plot", platform, {
					stacked: true,
					legend: true,
					color: { ...platformColor, legend: true },
					title: (row) =>
						`${row.series}: ${number.format(row.value)} (${((100 * row.value) / row.total).toFixed(
							1,
						)}%)`,
				});

				const line = (selector, field, color, tickFormat, source = rows, options = {}) => {
					const node = document.querySelector(selector);
					const plot = linePlot(source, field, color, tickFormat, {
						width: node.clientWidth || 320,
						floor: 0,
						...options,
					});
					if (plot) replacePlot(selector, plot);
					else node.replaceChildren();
				};
				const stackedArea = (selector, source, color) => {
					const node = document.querySelector(selector);
					if (!source.length) {
						node.replaceChildren();
						return;
					}
					replacePlot(
						selector,
						Plot.plot({
							width: node.clientWidth || 320,
							height: 190,
							marginTop: 34,
							marginRight: 12,
							marginBottom: 28,
							marginLeft: 43,
							style: { background: "transparent", color: "#7d8a96", fontSize: "10px" },
							x: { type: "utc", label: null, ticks: 5, tickFormat: "%b %-d", tickSize: 0 },
							y: {
								label: null,
								grid: true,
								domain: [0, 1],
								ticks: 5,
								tickSize: 0,
								tickFormat: (value) => `${Math.round(value * 100)}%`,
							},
							color: { ...color, legend: true },
							marks: [
								Plot.ruleY([0, 1], { stroke: "#dfe5e8" }),
								Plot.areaY(
									source,
									Plot.stackY(
										{ order: color.domain },
										{
											x: "date",
											y: "share",
											z: "series",
											fill: "series",
											fillOpacity: 1,
											curve: "monotone-x",
											tip: true,
											title: (row) =>
												`${shortDate.format(row.date)} · ${row.series}: ${(100 * row.share).toFixed(
													1,
												)}% · ${number.format(row.value)} solves`,
										},
									),
								),
							],
						}),
					);
				};

				line("#cases-plot", "cases_per_player", "#bd2d47", (value) => value.toFixed(1));
				line("#sessions-plot", "sessions_per_player", "#3a6ea5", (value) => value.toFixed(1));
				const dailyRows = rows.filter((row) => Number.isFinite(row.daily_pct));
				line("#daily-plot", "daily_pct", "#d89024", (value) => `${value.toFixed(0)}%`, dailyRows);
				line("#xp-plot", "xp_per_player", "#2a9d8f", (value) => compact.format(value));
				stackedArea("#cases-environment-plot", environments.rows, {
					domain: environments.domain,
					range: environments.keys.map(
						(key) =>
							({
								nextDoor: "#9c3e29",
								islands: "#1cadf4",
								grove: "#ff608a",
								farmyard: "#df7956",
								unknown: "#b8c0c7",
							})[key] ?? "#5b7894",
					),
				});
				stackedArea("#cases-difficulty-plot", difficulties.rows, {
					domain: difficulties.domain,
					range: difficulties.keys.map(
						(key) =>
							({
								easy: "#2abd88",
								medium: "#d89024",
								hard: "#bd2d47",
								free: "#7b61a8",
								unknown: "#b8c0c7",
							})[key] ?? "#5b7894",
					),
				});

				bars("#revenue-source-plot", revenueBySource, {
					stacked: true,
					legend: true,
					tickFormat: money.format,
					color: { domain: ["IAP", "Ads"], range: ["#d89024", "#14815d"], legend: true },
					title: (row) =>
						`${shortDate.format(row.date)} · ${row.series}: ${money.format(row.value)} ` +
						`of ${money.format(row.total)}`,
				});
				bars("#revenue-platform-plot", revenueByPlatform, {
					stacked: true,
					legend: true,
					tickFormat: money.format,
					color: { ...platformColor, legend: true },
					title: (row) =>
						`${shortDate.format(row.date)} · ${row.series}: ${money.format(row.value)} ` +
						`of ${money.format(row.total)}`,
				});
				const monetisationLineOptions = {
					height: 150,
					marginLeft: 38,
					fontSize: "9px",
					xTicks: 3,
				};
				line(
					"#arpdau-plot",
					"arpdau_usd",
					"#3a86a8",
					preciseMoney.format,
					rows,
					monetisationLineOptions,
				);
				line(
					"#conversion-plot",
					"conversion_pct",
					"#7b61a8",
					(value) => `${value.toFixed(1)}%`,
					rows,
					monetisationLineOptions,
				);
				line(
					"#ads-plot",
					"ads_per_dau",
					"#e76f51",
					(value) => value.toFixed(2),
					rows,
					monetisationLineOptions,
				);
				line(
					"#arppu-plot",
					"arppu_usd",
					"#bd2d47",
					preciseMoney.format,
					rows,
					monetisationLineOptions,
				);

				const revenueSourceAreaNode = document.querySelector("#revenue-source-area-plot");
				if (revenueSources.length) {
					const sourceColors = {
						ads: "#2a9d8f",
						remove_ads: "#d89024",
						hints: "#3a86a8",
						islands: "#7b61a8",
						grove: "#d65d9e",
						farmyard: "#df7956",
						other_iap: "#b8c0c7",
					};
					const sourceMoney = new Intl.NumberFormat("en", {
						style: "currency",
						currency: "USD",
						maximumFractionDigits: 2,
					});
					replacePlot(
						"#revenue-source-area-plot",
						Plot.plot({
							width: revenueSourceAreaNode.clientWidth || 320,
							height: 150,
							marginTop: 34,
							marginRight: 12,
							marginBottom: 28,
							marginLeft: 38,
							style: { background: "transparent", color: "#7d8a96", fontSize: "9px" },
							x: { type: "utc", label: null, ticks: 3, tickFormat: "%b %-d", tickSize: 0 },
							y: {
								label: null,
								grid: true,
								domain: [0, 1],
								ticks: 5,
								tickSize: 0,
								tickFormat: (value) => `${Math.round(value * 100)}%`,
							},
							color: {
								domain: revenueSourceKeys.map((key) => revenueSourceLabels[key] ?? key),
								range: revenueSourceKeys.map((key) => sourceColors[key] ?? "#5b7894"),
								legend: true,
							},
							marks: [
								Plot.ruleY([0, 1], { stroke: "#dfe5e8" }),
								Plot.areaY(
									revenueSources,
									Plot.stackY(
										{ order: revenueSourceKeys.map((key) => revenueSourceLabels[key] ?? key) },
										{
											x: "date",
											y: "share",
											z: "series",
											fill: "series",
											fillOpacity: 1,
											curve: "monotone-x",
											tip: true,
											title: (row) =>
												`${shortDate.format(row.date)} · ${row.series}: ${(100 * row.share).toFixed(
													1,
												)}% · ${sourceMoney.format(row.value)} of ${sourceMoney.format(row.total)}`,
										},
									),
								),
							],
						}),
					);
				} else revenueSourceAreaNode.replaceChildren();
			}

			function renderStickiness(rows) {
				const parsed = rows.map((row) => ({
					...row,
					date: new Date(`${row.day}T12:00:00Z`),
					dau: Number(row.dau),
					wau: Number(row.wau),
					dau_wau_pct: row.dau_wau_pct == null ? null : Number(row.dau_wau_pct),
					curr_eligible: row.curr_eligible == null ? null : Number(row.curr_eligible),
					curr_returned: row.curr_returned == null ? null : Number(row.curr_returned),
					curr_pct: row.curr_pct == null ? null : Number(row.curr_pct),
				}));
				const percentage = (value) => `${value.toFixed(0)}%`;
				const renderMetric = (selector, noteSelector, field, color, source, title) => {
					const node = document.querySelector(selector);
					const latest = source[source.length - 1];
					if (!latest) {
						document.querySelector(noteSelector).textContent = "not enough mature data";
						node.replaceChildren();
						return;
					}
					document.querySelector(noteSelector).textContent = `${latest[field].toFixed(1)}%`;
					replacePlot(
						selector,
						linePlot(source, field, color, percentage, {
							width: node.clientWidth || 320,
							floor: 0,
							ceiling: 100,
							title,
						}),
					);
				};

				const dauWau = parsed.filter((row) => Number.isFinite(row.dau_wau_pct));
				renderMetric(
					"#dau-wau-plot",
					"#dau-wau-note",
					"dau_wau_pct",
					"#234766",
					dauWau,
					(row) =>
						`${shortDate.format(row.date)}: ${row.dau_wau_pct.toFixed(1)}% · ` +
						`${number.format(row.dau)} DAU / ${number.format(row.wau)} WAU`,
				);

				const curr = parsed.filter((row) => Number.isFinite(row.curr_pct));
				renderMetric(
					"#curr-plot",
					"#curr-note",
					"curr_pct",
					"hsl(351deg 66% 48%)",
					curr,
					(row) =>
						`${shortDate.format(row.date)}: ${row.curr_pct.toFixed(1)}% · ` +
						`${number.format(row.curr_returned)} of ${number.format(row.curr_eligible)}`,
				);
			}

			function applyTrustFloor(data) {
				const trusted = (value) => typeof value === "string" && value.slice(0, 10) >= TRUSTED_FROM;
				return {
					...data,
					series: (data.series ?? []).filter((row) => trusted(row.day)),
					retention: (data.retention ?? []).filter((row) => trusted(row.cohort_day)),
					retention_series: (data.retention_series ?? [])
						.map((entry) => ({
							...entry,
							points: (entry.points ?? []).filter((point) => trusted(point.cohort_day)),
						}))
						.filter((entry) => entry.points.length),
					cohort_revenue_series: (data.cohort_revenue_series ?? [])
						.map((entry) => ({
							...entry,
							points: (entry.points ?? []).filter(
								(point) => typeof point.cohort_day === "string" && point.cohort_day >= "2026-07-14",
							),
						}))
						.filter((entry) => entry.points.length),
					revenue_sources: (data.revenue_sources ?? []).filter(
						(row) => typeof row.day === "string" && row.day >= "2026-07-14",
					),
					stickiness: (data.stickiness ?? []).filter((row) => trusted(row.day)),
					peak_dau: trusted(data.peak_dau?.day) ? data.peak_dau : null,
				};
			}

			function render(data) {
				data = applyTrustFloor(data);
				renderHourlyPlayers(data);
				renderPeak(data.peak_dau);
				renderRetention(data.retention, data.retention_series);
				renderCohortRevenue(data.cohort_revenue_series);
				renderStickiness(data.stickiness ?? []);
				renderPlots(data);
				document.querySelector("#footnotes").innerHTML = data.notes
					.map((note) => `<li>${note}</li>`)
					.join("");
				const generated = new Date(data.generated_at);
				updatedAt.textContent = `updated ${new Intl.RelativeTimeFormat("en", {
					numeric: "auto",
				}).format(-Math.max(0, Math.round((Date.now() - generated.getTime()) / 60000)), "minute")}`;
				liveStatus.dataset.state = "live";
				lastRenderedWidth = document.body.clientWidth;
				snapshot = data;
			}

			async function load(token, { first = false } = {}) {
				if (!token) return;
				liveStatus.dataset.state = "loading";
				let data;
				try {
					const response = await fetch(endpoint, {
						headers: { Authorization: `Bearer ${token}` },
						cache: "no-store",
					});
					if (!response.ok) {
						// Don't keep a rejected key around to fail again on every refresh.
						if (response.status === 401) forgetToken();
						throw new Error(
							response.status === 401 ? "Wrong access key." : "Dashboard is unavailable.",
						);
					}
					data = await response.json();
				} catch (error) {
					liveStatus.dataset.state = "error";
					if (first || !snapshot) {
						boot.hidden = true;
						document.documentElement.removeAttribute("data-has-key");
						access.hidden = false;
						dashboard.hidden = true;
						errorMessage.textContent = error.message;
					}
					return;
				}

				access.hidden = true;
				boot.hidden = true;
				document.documentElement.removeAttribute("data-has-key");
				dashboard.hidden = false;
				errorMessage.textContent = "";
				try {
					render(data);
					if (activeDashboardTab === "aso" && !ratingSnapshot) void loadInitialAso(token);
					if (activeDashboardTab === "experiments" && !experimentSnapshot) {
						void loadInitialExperiments(token);
					}
				} catch (error) {
					liveStatus.dataset.state = "error";
					updatedAt.textContent = "display error";
					console.error("Dashboard render failed", error);
				}
				clearTimeout(refreshTimer);
				refreshTimer = setTimeout(() => {
					if (!document.hidden) load(storedToken());
				}, 60_000);
			}

			form.addEventListener("submit", (event) => {
				event.preventDefault();
				const token = keyInput.value.trim();
				if (!token) return;
				storeToken(token);
				keyInput.value = "";
				boot.hidden = false;
				document.documentElement.dataset.hasKey = "";
				load(token, { first: true });
			});

			async function refreshAsoSelection({ includeRatings = false } = {}) {
				try {
					const data = await fetchAso(storedToken(), appStoreCountry.value, keywordName.value);
					if (includeRatings) renderRatings(data);
					renderKeywordRank(data);
					const generated = new Date(data.generated_at);
					document.querySelector("#aso-updated").textContent = `collected ${shortDate.format(
						generated,
					)}`;
				} catch (error) {
					document.querySelector("#aso-updated").textContent = error.message;
				}
			}

			for (const [index, button] of dashboardTabs.entries()) {
				button.addEventListener("click", () => {
					activateDashboardTab(button.dataset.dashboardTab, { updateHistory: true });
				});
				button.addEventListener("keydown", (event) => {
					let nextIndex;
					if (event.key === "ArrowRight") nextIndex = (index + 1) % dashboardTabs.length;
					if (event.key === "ArrowLeft") {
						nextIndex = (index - 1 + dashboardTabs.length) % dashboardTabs.length;
					}
					if (event.key === "Home") nextIndex = 0;
					if (event.key === "End") nextIndex = dashboardTabs.length - 1;
					if (nextIndex == null) return;
					event.preventDefault();
					const nextTab = dashboardTabs[nextIndex];
					nextTab.focus();
					activateDashboardTab(nextTab.dataset.dashboardTab, { updateHistory: true });
				});
			}

			window.addEventListener("popstate", () => activateDashboardTab(dashboardTabFromUrl()));

			appStoreCountry.addEventListener("change", () => {
				void refreshAsoSelection({ includeRatings: true });
			});
			keywordName.addEventListener("change", () => void refreshAsoSelection());
			experimentName.addEventListener("change", () => {
				experimentCountrySignature = "";
				experimentCountry.value = "all";
				void refreshExperimentSelection();
			});
			experimentPlatform.addEventListener("change", () => {
				experimentCountrySignature = "";
				experimentCountry.value = "all";
				void refreshExperimentSelection();
			});
			experimentCountry.addEventListener("change", () => void refreshExperimentSelection());

			document.addEventListener("visibilitychange", () => {
				if (!document.hidden && storedToken()) {
					load(storedToken());
					if (activeDashboardTab === "experiments" && experimentSnapshot) {
						void refreshExperimentSelection();
					}
				}
			});

			new ResizeObserver(() => {
				if (snapshot && Math.abs(document.body.clientWidth - lastRenderedWidth) > 30) {
					if (activeDashboardTab === "overview") {
						renderHourlyPlayers(snapshot);
						renderRetention(snapshot.retention, snapshot.retention_series);
						renderCohortRevenue(snapshot.cohort_revenue_series);
						renderStickiness(snapshot.stickiness ?? []);
						renderPlots(snapshot);
					} else if (activeDashboardTab === "aso") {
						if (ratingSnapshot) renderRatings(ratingSnapshot);
						if (keywordSnapshot) renderKeywordRank(keywordSnapshot);
					} else if (experimentSnapshot) {
						renderExperiment(experimentSnapshot);
					}
					lastRenderedWidth = document.body.clientWidth;
				}
			}).observe(document.body);

			const initialToken = consumeTokenFromHash() || storedToken();
			activateDashboardTab(dashboardTabFromUrl(), { renderView: false });
			if (initialToken) load(initialToken, { first: true });
		</script>
	</body>
</html>
