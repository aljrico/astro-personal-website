---
// Intentionally standalone: this private utility should not appear in the site
// navigation, sitemap, or shared public layout.
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow, noarchive" />
		<meta name="referrer" content="no-referrer" />
		<meta name="theme-color" content="#f7f7f4" />
		<title>Murder Sudoku: Tiny Crimes · Live</title>
		<script is:inline>
			try {
				const fromHash = decodeURIComponent(location.hash.slice(1)).trim();
				if (fromHash || localStorage.getItem("verdoku-dashboard-key"))
					document.documentElement.dataset.hasKey = "";
			} catch {}
		</script>
		<style>
			@font-face {
				font-family: "Styrene B";
				font-style: normal;
				font-weight: 400;
				font-display: swap;
				src: url("/fonts/StyreneB-Regular.woff2") format("woff2");
			}

			@font-face {
				font-family: "Styrene B";
				font-style: normal;
				font-weight: 600 800;
				font-display: swap;
				src: url("/fonts/StyreneB-Bold.woff2") format("woff2");
			}

			@font-face {
				font-family: "Tiempos Text";
				font-style: normal;
				font-weight: 700;
				font-display: swap;
				src: url("/fonts/TiemposText-Bold.woff2") format("woff2");
			}

			:root {
				color-scheme: light;
				--paper: #f7f7f4;
				--card: #ffffff;
				--ink: #26323d;
				--muted: #7d8a96;
				--faint: #a5afb8;
				--line: #e3e7e8;
				--grid: #e9eef2;
				--navy: #234766;
				--red: hsl(351deg 66% 48%);
				--green: #2abd88;
				--amber: #d89024;
			}

			* {
				box-sizing: border-box;
			}

			html {
				background: var(--paper);
			}

			body {
				margin: 0;
				min-width: 320px;
				font-family:
					"Styrene B",
					ui-sans-serif,
					system-ui,
					-apple-system,
					sans-serif;
				color: var(--ink);
				background: var(--paper);
				-webkit-font-smoothing: antialiased;
			}

			button,
			input,
			select {
				font: inherit;
			}

			select {
				min-width: 112px;
				padding: 7px 30px 7px 10px;
				border: 1px solid var(--line);
				border-radius: 8px;
				color: var(--ink);
				background: var(--card);
				font-size: 10px;
				font-weight: 700;
			}

			.panel-controls {
				display: flex;
				align-items: center;
				gap: 7px;
				flex-wrap: wrap;
				justify-content: flex-end;
			}

			.competitor-picker {
				min-width: 148px;
				font-size: 10px;
			}

			.competitor-picker summary {
				padding: 7px 10px;
				border: 1px solid var(--line);
				border-radius: 8px;
				list-style: none;
				color: var(--ink);
				background: var(--card);
				font-weight: 700;
				cursor: pointer;
			}

			.competitor-picker summary::-webkit-details-marker {
				display: none;
			}

			.competitor-options {
				display: grid;
				gap: 7px;
				margin-top: 6px;
				padding: 9px 10px;
				border: 1px solid var(--line);
				border-radius: 8px;
				background: var(--card);
			}

			:global(.competitor-option) {
				display: flex;
				align-items: center;
				gap: 7px;
				white-space: nowrap;
				cursor: pointer;
			}

			:global(.competitor-option input) {
				margin: 0;
				accent-color: var(--red);
			}

			.aso-status {
				margin: 4px 0 0;
				color: var(--muted);
				font-size: 10px;
			}

			.experiment-hero {
				padding-bottom: 18px;
			}

			.experiment-title-row {
				display: flex;
				align-items: center;
				gap: 8px;
				flex-wrap: wrap;
			}

			.experiment-title-row h3 {
				margin: 0;
				font-family: "Tiempos Text", Georgia, serif;
				font-size: 22px;
			}

			.phase-pill {
				padding: 4px 7px 3px;
				border-radius: 999px;
				color: var(--navy);
				background: color-mix(in srgb, var(--navy) 10%, transparent);
				font-size: 9px;
				font-weight: 800;
				letter-spacing: 0.05em;
				text-transform: uppercase;
			}

			.phase-pill[data-phase="running"] {
				color: #14815d;
				background: color-mix(in srgb, var(--green) 13%, transparent);
			}

			.phase-pill[data-phase="winner_rollout"] {
				color: #9b6514;
				background: color-mix(in srgb, var(--amber) 15%, transparent);
			}

			.experiment-metric-copy {
				margin: 7px 0 0;
				color: var(--muted);
				font-size: 10px;
				line-height: 1.5;
			}

			.experiment-summary {
				display: grid;
				grid-template-columns: repeat(4, 1fr);
				gap: 8px;
				margin-top: 18px;
			}

			.experiment-stat {
				min-width: 0;
				padding-top: 12px;
				border-top: 1px solid var(--line);
			}

			.experiment-stat span {
				display: block;
				color: var(--muted);
				font-size: 9px;
				font-weight: 700;
				letter-spacing: 0.04em;
				text-transform: uppercase;
			}

			.experiment-stat strong {
				display: block;
				margin-top: 5px;
				font-family: "Tiempos Text", Georgia, serif;
				font-size: 21px;
				font-variant-numeric: tabular-nums;
			}

			.experiment-stat strong[data-kind="dates"] {
				font-size: 15px;
				line-height: 1.3;
			}

			.experiment-health {
				display: flex;
				gap: 6px;
				margin-top: 14px;
				flex-wrap: wrap;
			}

			.experiment-metrics-grid {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 12px;
				margin-bottom: 12px;
			}

			:global(.experiment-metric-panel) {
				margin-bottom: 0;
				padding: 18px 18px 14px;
				border: 1px solid var(--line);
				border-radius: 12px;
				overflow: hidden;
				background: color-mix(in srgb, var(--card) 82%, transparent);
			}

			:global(.experiment-metric-panel .panel-head) {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				gap: 12px;
				margin-bottom: 12px;
			}

			:global(.experiment-metric-panel .panel-title) {
				margin: 0;
				font-size: 12px;
				font-weight: 800;
			}

			:global(.experiment-metric-panel .panel-note) {
				margin: 0;
				color: var(--muted);
				font-size: 10px;
			}

			:global(.experiment-metric-panel .plot) {
				width: 100%;
				min-height: 170px;
			}

			:global(.experiment-metric-panel .plot svg) {
				display: block;
				max-width: 100%;
				overflow: visible;
				font-family: "Styrene B", ui-sans-serif, system-ui, sans-serif;
			}

			.plot-grid > :only-child {
				grid-column: 1 / -1;
			}

			:global(.health-chip) {
				padding: 5px 7px;
				border: 1px solid color-mix(in srgb, var(--green) 28%, var(--line));
				border-radius: 7px;
				color: #14815d;
				background: color-mix(in srgb, var(--green) 6%, transparent);
				font-size: 9px;
				font-weight: 700;
			}

			:global(.health-chip[data-state="warn"]) {
				border-color: color-mix(in srgb, var(--amber) 35%, var(--line));
				color: #9b6514;
				background: color-mix(in srgb, var(--amber) 7%, transparent);
			}

			:global(.health-chip[data-state="bad"]) {
				border-color: color-mix(in srgb, var(--red) 30%, var(--line));
				color: var(--red);
				background: color-mix(in srgb, var(--red) 6%, transparent);
			}

			.shell {
				width: min(100% - 32px, 760px);
				margin: 0 auto;
				padding: 34px 0 60px;
			}

			.topbar {
				display: flex;
				align-items: flex-start;
				justify-content: space-between;
				gap: 24px;
				margin-bottom: 28px;
			}

			.eyebrow {
				margin: 0 0 6px;
				color: var(--red);
				font-size: 11px;
				font-weight: 800;
				letter-spacing: 0.13em;
				text-transform: uppercase;
			}

			h1,
			h2 {
				font-family: "Tiempos Text", Georgia, serif;
			}

			h1 {
				margin: 0;
				font-size: clamp(32px, 8vw, 48px);
				line-height: 0.98;
				letter-spacing: -0.02em;
			}

			.live-status {
				display: flex;
				align-items: center;
				gap: 7px;
				margin-top: 7px;
				color: var(--muted);
				font-size: 11px;
				white-space: nowrap;
			}

			.status-dot {
				width: 7px;
				height: 7px;
				border-radius: 999px;
				background: var(--amber);
				box-shadow: 0 0 0 4px color-mix(in srgb, var(--amber) 15%, transparent);
			}

			.live-status[data-state="live"] .status-dot {
				background: var(--green);
				box-shadow: 0 0 0 4px color-mix(in srgb, var(--green) 15%, transparent);
			}

			.summary {
				display: grid;
				grid-template-columns: repeat(4, 1fr);
				gap: 10px;
				margin-bottom: 32px;
			}

			.metric,
			.panel {
				border: 1px solid var(--line);
				background: color-mix(in srgb, var(--card) 82%, transparent);
			}

			.metric {
				min-width: 0;
				padding: 16px 14px 14px;
				border-radius: 12px;
			}

			.metric-label {
				display: block;
				margin-bottom: 9px;
				color: var(--muted);
				font-size: 10px;
				font-weight: 700;
				letter-spacing: 0.06em;
				text-transform: uppercase;
			}

			.metric-value {
				display: block;
				font-family: "Tiempos Text", Georgia, serif;
				font-size: clamp(25px, 5vw, 34px);
				line-height: 1;
				font-variant-numeric: tabular-nums;
			}

			.metric-change {
				display: block;
				margin-top: 8px;
				color: var(--muted);
				font-size: 10px;
				font-variant-numeric: tabular-nums;
			}

			.metric-change[data-direction="up"] {
				color: #14815d;
			}

			.metric-change[data-direction="down"] {
				color: var(--red);
			}

			.section-heading {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				gap: 16px;
				margin: 0 0 12px;
			}

			.section-heading h2 {
				margin: 0;
				font-size: 22px;
			}

			.section-heading span {
				color: var(--muted);
				font-size: 10px;
			}

			.panel {
				margin-bottom: 12px;
				padding: 18px 18px 14px;
				border-radius: 12px;
				overflow: hidden;
			}

			.panel-head {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				gap: 12px;
				margin-bottom: 12px;
			}

			.panel-title {
				margin: 0;
				font-size: 12px;
				font-weight: 800;
			}

			.panel-note {
				margin: 0;
				color: var(--muted);
				font-size: 10px;
			}

			.plot {
				width: 100%;
				min-height: 170px;
			}

			.plot svg {
				display: block;
				max-width: 100%;
				overflow: visible;
				font-family: "Styrene B", ui-sans-serif, system-ui, sans-serif;
			}

			.plot-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 12px;
			}

			.plot-grid.three {
				grid-template-columns: repeat(3, 1fr);
			}

			.retention {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 12px;
				margin-bottom: 32px;
			}

			.retention .panel {
				min-width: 0;
				margin-bottom: 0;
				padding-inline: 12px;
			}

			.retention .plot {
				min-height: 150px;
			}

			.footnotes {
				margin: 20px 2px 0;
				padding: 0;
				list-style: none;
				color: var(--muted);
				font-size: 10px;
				line-height: 1.55;
			}

			.footnotes li::before {
				content: "— ";
			}

			.access,
			.boot {
				display: grid;
				min-height: 80vh;
				place-items: center;
			}

			.boot {
				display: none;
				text-align: center;
			}

			.boot p:last-child {
				margin: 10px 0 0;
				color: var(--muted);
				font-size: 12px;
			}

			html[data-has-key] .access {
				display: none;
			}

			html[data-has-key] .boot {
				display: grid !important;
			}

			.access-card {
				width: min(100%, 390px);
				padding: 26px;
				border: 1px solid var(--line);
				border-radius: 14px;
				background: var(--card);
			}

			.access-card h1 {
				margin-bottom: 10px;
				font-size: 34px;
			}

			.access-card p {
				margin: 0 0 20px;
				color: var(--muted);
				font-size: 12px;
				line-height: 1.5;
			}

			.access-form {
				display: flex;
				gap: 8px;
			}

			.access-form input {
				min-width: 0;
				flex: 1;
				padding: 11px 12px;
				border: 1px solid var(--line);
				border-radius: 8px;
				outline: none;
				color: var(--ink);
				background: var(--paper);
			}

			.access-form input:focus {
				border-color: var(--red);
				box-shadow: 0 0 0 3px color-mix(in srgb, var(--red) 12%, transparent);
			}

			.access-form button {
				padding: 11px 15px;
				border: 0;
				border-radius: 8px;
				color: white;
				background: var(--red);
				font-weight: 800;
				cursor: pointer;
			}

			.access-error {
				min-height: 17px;
				margin: 10px 0 0 !important;
				color: var(--red) !important;
			}

			[hidden] {
				display: none !important;
			}

			@media (max-width: 620px) {
				.shell {
					width: min(100% - 24px, 760px);
					padding-top: 24px;
				}

				.summary {
					grid-template-columns: 1fr 1fr;
				}

				.experiment-summary {
					grid-template-columns: 1fr 1fr;
				}

				.experiment-metrics-grid {
					grid-template-columns: 1fr;
				}

				.plot-grid {
					grid-template-columns: 1fr;
				}

				.retention {
					grid-template-columns: 1fr;
				}

				.panel {
					padding-inline: 14px;
				}
			}

			@media (prefers-reduced-motion: reduce) {
				* {
					scroll-behavior: auto !important;
				}
			}
		</style>
	</head>
	<body>
		<main class="shell">
			<section class="boot" id="boot" hidden aria-live="polite">
				<div>
					<p class="eyebrow">Murder Sudoku: Tiny Crimes</p>
					<h1>Reading the room.</h1>
					<p>Loading live numbers…</p>
				</div>
			</section>

			<section class="access" id="access">
				<div class="access-card">
					<p class="eyebrow">Private</p>
					<h1>Murder Sudoku: Tiny Crimes</h1>
					<p>Paste the access key, or open the private link you were sent.</p>
					<form class="access-form" id="access-form">
						<input
							id="access-key"
							type="password"
							autocomplete="current-password"
							aria-label="Access key"
						/>
						<button type="submit">Open</button>
					</form>
					<p class="access-error" id="access-error" role="alert"></p>
				</div>
			</section>

			<section id="dashboard" hidden>
				<header class="topbar">
					<div>
						<p class="eyebrow">Murder Sudoku: Tiny Crimes</p>
						<h1>The pulse.</h1>
					</div>
					<div class="live-status" id="live-status" data-state="loading">
						<span class="status-dot"></span>
						<span id="updated-at">Loading</span>
					</div>
				</header>

				<section class="summary" aria-label="Today so far">
					<div class="metric" data-metric="dau"></div>
					<div class="metric" data-metric="new_installs"></div>
					<div class="metric" data-metric="cases_solved"></div>
					<div class="metric" data-metric="purchases"></div>
				</section>

				<div class="section-heading">
					<h2>Retention</h2>
					<span>matured · n≥100 · by install date</span>
				</div>

				<section class="retention" aria-label="Matured retention">
					<section class="panel">
						<div class="panel-head">
							<h3 class="panel-title">D1</h3>
							<p class="panel-note" id="retention-d1-note">matured cohorts</p>
						</div>
						<div class="plot" id="retention-d1-plot"></div>
					</section>
					<section class="panel">
						<div class="panel-head">
							<h3 class="panel-title">D3</h3>
							<p class="panel-note" id="retention-d3-note">matured cohorts</p>
						</div>
						<div class="plot" id="retention-d3-plot"></div>
					</section>
					<section class="panel">
						<div class="panel-head">
							<h3 class="panel-title">D7</h3>
							<p class="panel-note" id="retention-d7-note">matured cohorts</p>
						</div>
						<div class="plot" id="retention-d7-plot"></div>
					</section>
					<section class="panel">
						<div class="panel-head">
							<h3 class="panel-title">D14</h3>
							<p class="panel-note" id="retention-d14-note">matured cohorts</p>
						</div>
						<div class="plot" id="retention-d14-plot"></div>
					</section>
				</section>

				<div class="section-heading">
					<h2>Stickiness</h2>
					<span>last 30 days · UTC · complete days only</span>
				</div>

				<div class="plot-grid">
					<section class="panel">
						<div class="panel-head">
							<h3 class="panel-title">DAU / WAU</h3>
							<p class="panel-note" id="dau-wau-note">trailing 7 days</p>
						</div>
						<div class="plot" id="dau-wau-plot"></div>
					</section>

					<section class="panel">
						<div class="panel-head">
							<h3 class="panel-title">CURR</h3>
							<p class="panel-note" id="curr-note">established players · D+1</p>
						</div>
						<div class="plot" id="curr-plot"></div>
					</section>
				</div>

				<div class="section-heading">
					<h2>Audience</h2>
					<span>last 30 days · UTC · complete days only</span>
				</div>

				<section class="panel">
					<div class="panel-head">
						<h3 class="panel-title">Daily active players</h3>
						<p class="panel-note" id="dau-note">DAU</p>
					</div>
					<div class="plot" id="dau-plot"></div>
				</section>

				<div class="plot-grid">
					<section class="panel">
						<div class="panel-head">
							<h3 class="panel-title">New + existing players</h3>
							<p class="panel-note">stacked</p>
						</div>
						<div class="plot" id="player-mix-plot"></div>
					</section>

					<section class="panel">
						<div class="panel-head">
							<h3 class="panel-title">New + existing players</h3>
							<p class="panel-note">trend</p>
						</div>
						<div class="plot" id="player-mix-lines-plot"></div>
					</section>
				</div>

				<section class="panel">
					<div class="panel-head">
						<h3 class="panel-title">Countries</h3>
						<p class="panel-note" id="country-note">daily top 3 · others</p>
					</div>
					<div class="plot" id="country-plot"></div>
				</section>

				<section class="panel">
					<div class="panel-head">
						<h3 class="panel-title">Platforms</h3>
						<p class="panel-note" id="platform-note">iOS · Android</p>
					</div>
					<div class="plot" id="platform-plot"></div>
				</section>

				<div class="section-heading">
					<h2>App Store</h2>
					<div class="panel-controls">
						<span id="aso-updated">daily positioning</span>
						<select id="app-store-country" aria-label="App Store country"></select>
						<details class="competitor-picker" id="competitor-picker">
							<summary id="competitor-summary">Competitors</summary>
							<div class="competitor-options" id="competitor-options"></div>
						</details>
					</div>
				</div>

				<div class="plot-grid">
					<section class="panel">
						<div class="panel-head">
							<h3 class="panel-title">Total ratings</h3>
							<p class="panel-note" id="total-ratings-note">public count</p>
						</div>
						<div class="plot" id="total-ratings-plot"></div>
					</section>

					<section class="panel">
						<div class="panel-head">
							<div>
								<h3 class="panel-title">Keyword position</h3>
								<p class="aso-status" id="keyword-rank-note">organic App Store rank</p>
							</div>
							<div class="panel-controls">
								<select id="keyword-name" aria-label="Keyword"></select>
							</div>
						</div>
